{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "rpms/**",
    ".tekton/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned image digests in generate_resources.py and check_upstream_versions.py",
      "managerFilePatterns": [
        "/ci/generate_resources\\.py$/",
        "/ci/check_upstream_versions\\.py$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*[A-Z_]+\\s*=\\s*\"[^\"@:]+(?::(?<currentValue>[^\"@]+))?@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Testing Farm IMAGE_TAG in integration test scenario templates",
      "managerFilePatterns": [
        "/konflux-templates/macros/integration-test-scenarios\\.yml\\.j2$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*-\\s*\\{name:\\s*IMAGE_TAG,\\s*value:\\s*(?<currentValue>v[\\d.]+)\\}"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update Testing Farm IMAGE_TAG in rendered Konflux YAML",
      "managerFilePatterns": [
        "/konflux-templates/rendered\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*-\\s*\\{name:\\s*IMAGE_TAG,\\s*value:\\s*(?<currentValue>v[\\d.]+)\\}"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update release-service-catalog git reference in Konflux template",
      "managerFilePatterns": ["/konflux-templates/konflux-resources\\.yml\\.j2$/"],
      "matchStrings": [
        "{#-?\\s*renovate:\\s*datasource=git-refs\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\s*#}\\n{%-?\\s*set\\s+release_catalog_revision\\s*=\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Update release-service-catalog git reference in rendered Konflux YAML",
      "managerFilePatterns": ["/konflux-templates/rendered\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=git-refs\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\n\\s*value:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group all rpmbuild-pipeline updates together",
      "matchPackageNames": ["/rpmbuild-pipeline/"],
      "groupName": "rpmbuild-pipeline"
    },
    {
      "description": "Group testing-farm IMAGE_TAG updates (template + rendered) into one PR",
      "matchManagers": ["regex"],
      "matchPackageNames": ["quay.io/testing-farm/tmt-via-testing-farm"],
      "groupName": "testing-farm-tmt-via-testing-farm"
    },
    {
      "description": "Regenerate rendered Tekton YAML after image digest updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["ci/generate_resources.py"],
      "postUpgradeTasks": {
        "commands": ["ci/renovate.sh"],
        "fileFilters": [".tekton/**"],
        "executionMode": "branch"
      }
    }
  ]
}
