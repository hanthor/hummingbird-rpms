summary: Test built RPM artifacts
execute:
  how: tmt
prepare:
  - how: install
    package: [rpmlint, podman, slirp4netns, rsync, python3.11, python3.11-pip]
  - how: shell
    script: |
      set -euo pipefail
      if [[ -z ${CONTAINERS_CONF_OVERRIDE:-} ]]; then
        configuration="${TMT_PLAN_DATA}/containers.conf"
        printf '%s\n' '[containers]' 'dns_servers = ["1.1.1.1", "8.8.8.8"]' > "$configuration"
        printf 'CONTAINERS_CONF_OVERRIDE=%q\n' "$configuration" >> "$TMT_PLAN_ENVIRONMENT_FILE"
      fi
  - how: shell
    script: |
      set -euo pipefail
      ci/prepare_rpm_artifacts.sh
  - how: shell
    script: |
      set -euo pipefail
      bootstrap="${TMT_PLAN_DATA}/bootstrap"
      python3.11 -m venv "$bootstrap"
      "$bootstrap/bin/pip" install --quiet uv==0.13.1
      export UV_PROJECT_ENVIRONMENT="${TMT_PLAN_DATA}/python"
      "$bootstrap/bin/uv" sync --python python3.11 --frozen --no-dev \
        --project "${TMT_TREE}/tools/tmt-rpmtest"
      test -x "$UV_PROJECT_ENVIRONMENT/bin/python"
      "$UV_PROJECT_ENVIRONMENT/bin/python" -c 'import tmt_rpmtest'
      printf 'RPMTEST_PYTHON=%q\n' "$UV_PROJECT_ENVIRONMENT/bin/python" >> "$TMT_PLAN_ENVIRONMENT_FILE"
      printf 'RPMTEST_CACHE=%q\n' "${TMT_PLAN_DATA}/rpmtest-cache" >> "$TMT_PLAN_ENVIRONMENT_FILE"

finish:
  how: shell
  script: |
    python="${TMT_PLAN_DATA}/python/bin/python"
    if [[ -x $python ]]; then
      "$python" -m tmt_rpmtest.environment finish --directory "${TMT_PLAN_DATA}/rpmtest"
    fi

discover:
  - name: rpm-checks
    how: shell
    keep-git-metadata: true
    tests:
      - name: RPM checks
        duration: 8h
        test: |
          set -euo pipefail
          [[ -n ${RPMTEST_SOURCE_RPM:-} ]] || exit 0
          rpm_arguments=()
          for artifact in "${RPMTEST_RPMS}"/*.rpm; do
            rpm_arguments+=(--rpm "$artifact")
          done
          ci/run_tests_rpm.sh -j "${rpm_arguments[@]}" \
            --repo-dir "${RPMTEST_RPMS}" --src-rpm "${RPMTEST_SOURCE_RPM}" "${RPMTEST_PACKAGE}"
      - name: Installed package contracts
        duration: 8h
        test: |
          set -euo pipefail
          if [[ ${RPMTEST_NO_NATIVE:-false} == true ]]; then
            echo "Build contains only RPMs for another architecture."
            tmt-report-result / skip
            exit 0
          fi
          "$RPMTEST_PYTHON" -m tmt_rpmtest.execution.universal \
            --artifacts "${RPMTEST_RPMS:?}" \
            --directory "${TMT_PLAN_DATA}/rpmtest/universal" \
            --cache "${TMT_PLAN_DATA}/rpmtest-cache" \
            --catalog "${RPMTEST_ARTIFACT_MANIFEST:?}" \
            --source "${RPMTEST_SOURCE_RPM:?Build source RPM is required}" \
            --package "${RPMTEST_PACKAGE:?}"
  - name: rpmtest
    how: fmf
    path: $TMT_TREE/test/rpmtest
    test: ^/[^/]+/tests/
    filter: component:${IMAGE_NAME}
