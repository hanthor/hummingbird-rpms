---
execute:
  how: tmt

prepare:
  - how: install
    package: rpmlint
  - how: install
    package: podman
  - how: shell
    script: |
      #!/bin/bash
      set -euo pipefail
      shopt -s inherit_errexit

      mkdir -p ~/.local/bin

      ARCH="$(arch)"
      case $ARCH in
          "x86_64")
              ARCH="amd64"
              ;;
          "aarch64")
              ARCH="arm64"
              ;;
      esac

      OS="linux"
      oras_version="1.3.0"
      oras_archive=$(mktemp)
      curl \
        --location \
        --silent \
        --fail \
        --show-error \
        --retry 5 \
        --retry-delay 5 \
        --connect-timeout 30 \
        --globoff \
        --output "${oras_archive}" \
        "https://github.com/oras-project/oras/releases/download/v${oras_version}/oras_${oras_version}_${OS}_${ARCH}.tar.gz"
      tar \
        --extract \
        --gzip \
        --file "${oras_archive}" \
        --directory ~/.local/bin \
        oras
      rm -f "${oras_archive}"

  # fix TF not being able to deal with newly added submodules in MRs
  # https://issues.redhat.com/browse/TFT-3991
  - how: shell
    script: git submodule update --init --recursive

discover:
  how: shell
  keep-git-metadata: true
  sync-repo: true
  tests:
    - name: Podman
      test: |
        #!/bin/bash
        set -euo pipefail
        shopt -s inherit_errexit

        # Validate required variables
        if [[ -z ${IMAGE_NAME:-} ]]; then
          echo "Error: IMAGE_NAME is required"
          exit 1
        fi

        if [[ -z ${IMAGE_URL:-} ]]; then
          echo "Error: IMAGE_URL is required"
          exit 1
        fi

        # Extract package name from IMAGE_NAME (remove -main suffix if present)
        package_name=${IMAGE_NAME%-main}

        # Create temporary directory for RPM artifacts
        files_dir=$(mktemp -d)
        trap "rm -rf ${files_dir}" EXIT

        # Fetch RPMs from ORAS container image
        oras pull "${IMAGE_URL}" -o "${files_dir}"

        # Run tests with the fetched RPM directory
        ci/run_tests_rpm.sh --repo "${files_dir}" "${package_name}"
