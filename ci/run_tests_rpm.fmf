---
execute:
  how: tmt

prepare:
  - how: install
    package: podman
  - how: shell
    script: |
      #!/bin/bash
      set -euo pipefail
      shopt -s inherit_errexit

      mkdir -p ~/.local/bin

      ARCH="$(arch)"
      case $ARCH in
          "x86_64")
              ARCH="amd64"
              ;;
          "aarch64")
              ARCH="arm64"
              ;;
      esac

      OS="linux"
      oras_version="1.3.0"
      oras_archive=$(mktemp)
      curl \
        --location \
        --silent \
        --fail \
        --show-error \
        --retry 5 \
        --retry-delay 5 \
        --connect-timeout 30 \
        --globoff \
        --output "${oras_archive}" \
        "https://github.com/oras-project/oras/releases/download/v${oras_version}/oras_${oras_version}_${OS}_${ARCH}.tar.gz"
      tar \
        --extract \
        --gzip \
        --file "${oras_archive}" \
        --strip 1 \
        --directory ~/.local/bin \
        oras-install/oras
      rm -f "${oras_archive}"

  # fix TF not being able to deal with newly added submodules in MRs
  # https://issues.redhat.com/browse/TFT-3991
  - how: shell
    script: git submodule update --init --recursive

discover:
  how: shell
  keep-git-metadata: true
  sync-repo: true
  tests:
    - name: Podman
      environment:
        TEST_ENGINE_ARGS: "--engine podman"
      test: &test_script |
        #!/bin/bash
        set -euo pipefail
        shopt -s inherit_errexit
        read -ra script_args <<< "${TEST_ENGINE_ARGS:?}"
        env
        echo "IMAGE_NAME: ${IMAGE_NAME:-unset}"
        echo "IMAGE_URL: ${IMAGE_URL:-unset}"
        if [[ -n ${IMAGE_URL:-} ]]; then
          #script_args+=("--component-name" "${IMAGE_NAME}" "--include-reverse-deps")
          #ci/run_tests_container.sh "${script_args[@]}"
          files_dir=$(mktemp -d)
          oras pull "${IMAGE_URL}" -o "${files_dir}"
          ls -l "${files_dir}"
        fi
