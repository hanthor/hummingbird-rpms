From 840b8dcdd68efc90ebc43d0798372f83cd5eb48e Mon Sep 17 00:00:00 2001
From: Evan Goode <mail@evangoo.de>
Date: Fri, 9 Oct 2026 16:52:15 -0400
Subject: [PATCH] repo_rpmdb.c: Use TAG_SHA256HEADER if no TAG_SHA1HEADER

Unlike RPM's V4 package format [1], RPM's V6 format [2] does not
guarantee the presence of the SHA1 tag. Only SHA256 and SHA3_256 are
guaranteed.

If there is no SHA1 header, libsolv should fall back to reading the
SHA256 header in rpmhead2solv and repo_add_rpm. This way, we do not
change behavior for existing RPM V4 packages which may contain both a
SHA1 and SHA256 header.

[1] https://rpm-software-management.github.io/rpm/manual/format_v4.html
[2] https://rpm-software-management.github.io/rpm/manual/format_v6.html
---
 ext/repo_rpmdb.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/ext/repo_rpmdb.c b/ext/repo_rpmdb.c
index 28b6e94d..8e3e35bb 100644
--- a/ext/repo_rpmdb.c
+++ b/ext/repo_rpmdb.c
@@ -1246,6 +1246,12 @@ rpmhead2solv(Pool *pool, Repo *repo, Repodata *data, Solvable *s, RpmHead *rpmhe
 	    repodata_set_checksum(data, handle, SOLVABLE_HDRID, REPOKEY_TYPE_SHA1, str);
 	  else if (str && strlen(str) == 64)
 	    repodata_set_checksum(data, handle, SOLVABLE_HDRID, REPOKEY_TYPE_SHA256, str);
+	  else
+	    {
+	      str = headstring(rpmhead, TAG_SHA256HEADER);
+	      if (str && strlen(str) == 64)
+	        repodata_set_checksum(data, handle, SOLVABLE_HDRID, REPOKEY_TYPE_SHA256, str);
+	    }
 	}
       u32 = headint32(rpmhead, TAG_BUILDTIME);
       if (u32)
@@ -2064,6 +2070,15 @@ repo_add_rpm(Repo *repo, const char *rpm, int flags)
 	      if (solv_hex2bin(&str, hdrid, 32) == 32)
 	        hdridtype = REPOKEY_TYPE_SHA256;
 	    }
+	  else
+	    {
+	      str = headstring(state.rpmhead, TAG_SHA256HEADER);
+	      if (str && strlen(str) == 64)
+	        {
+	          if (solv_hex2bin(&str, hdrid, 32) == 32)
+	            hdridtype = REPOKEY_TYPE_SHA256;
+	        }
+	    }
 	}
     }
   else
