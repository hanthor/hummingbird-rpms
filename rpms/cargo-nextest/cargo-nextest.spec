Name:           cargo-nextest
Version:        0.9.151
Release:        0.1%{?dist}
Summary:        Isolated test runner for Rust packages

# Includes bundled dependencies, as reported by %%cargo_license_summary.
# The internal nextest-workspace-hack crate uses the top-level project license.
License:        Apache-2.0 AND Apache-2.0 WITH LLVM-exception AND BSD-3-Clause AND BSL-1.0 AND ISC AND MIT AND MPL-2.0 AND WTFPL AND Zlib AND ((MIT OR Apache-2.0) AND Unicode-3.0) AND ((MIT OR Apache-2.0) AND Unicode-DFS-2016) AND (0BSD OR MIT OR Apache-2.0) AND (Apache-2.0 OR BSL-1.0 OR MIT) AND (Apache-2.0 OR ISC OR MIT) AND (Apache-2.0 OR MIT) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (BSD-2-Clause OR Apache-2.0 OR MIT) AND (CC0-1.0 OR MIT-0 OR Apache-2.0) AND (ISC AND (Apache-2.0 OR ISC)) AND (ISC AND (Apache-2.0 OR ISC) AND Apache-2.0 AND MIT AND BSD-3-Clause AND (Apache-2.0 OR ISC OR MIT) AND (Apache-2.0 OR ISC OR MIT-0)) AND (MIT AND Unicode-DFS-2016) AND (MIT OR Apache-2.0) AND (MIT OR Apache-2.0 OR LGPL-2.1-or-later) AND (MIT OR Apache-2.0 OR Zlib) AND (MIT OR Zlib OR Apache-2.0) AND (Unlicense OR MIT) AND (Zlib OR Apache-2.0 OR MIT)
URL:            https://github.com/nextest-rs/nextest
# Generated by gorget; see metadata/cargo-nextest.source-pipeline.yaml.
Source0:        %{name}-%{version}.tar.gz
Source1:        %{name}-%{version}-vendor.tar.xz
Source2:        macros.cargo-nextest

BuildRequires:  cargo-rpm-macros >= 28
BuildRequires:  rust >= 1.91
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  mold
Requires:       cargo-rpm-macros >= 28

# Upstream builds with Cargo's default release settings: 16 codegen units, no
# LTO. Fedora's -Ccodegen-units=1 makes this large crate graph compile much
# slower and peak at more memory per crate. RUSTFLAGS are appended after the
# profile flags, so the last -C value wins. mold keeps the debug-info links,
# which the default linker does in several GiB, cheap.
%global build_rustflags %{build_rustflags} -Ccodegen-units=16 -Clink-arg=-fuse-ld=mold

%description
Nextest runs Rust unit and integration tests in isolated processes. This package
also supplies the optional %%cargo_nextest RPM macro, which preserves the RPM
build profile and runs doctests separately with cargo test.

%prep
%autosetup -n %{name}-%{version}
tar xf %{SOURCE1}
%cargo_prep -v vendor

%build
# Distributors must not let the executable replace itself outside RPM.
%cargo_build -n -f default-no-update -- --locked -p cargo-nextest
%cargo_vendor_manifest
cargo tree -p cargo-nextest --no-default-features --features default-no-update \
    -e normal,build --offline --locked --prefix none --no-dedupe \
    | sed -E 's/^([A-Za-z0-9_.+-]+) (v[0-9][^ ]*).*/\1 \2/' \
    | sort -u > shipped-crates.txt
grep -Fxf shipped-crates.txt cargo-vendor.txt > cargo-vendor.txt.filtered
mv cargo-vendor.txt.filtered cargo-vendor.txt
pushd cargo-nextest
%{cargo_license_summary -n -f default-no-update}
%{cargo_license -n -f default-no-update} > ../LICENSE.dependencies
popd

%install
install -Dpm 0755 target/rpm/cargo-nextest %{buildroot}%{_bindir}/cargo-nextest
install -Dpm 0644 %{SOURCE2} %{buildroot}%{_rpmmacrodir}/macros.cargo-nextest

%check
target/rpm/cargo-nextest nextest --version
# Bootstrap with the existing runner; building nextest must not require nextest.
%cargo_test -n -f default-no-update -- -p cargo-nextest --lib --bins

%files
%license LICENSE-APACHE LICENSE-MIT LICENSE.dependencies
%license cargo-vendor.txt
%{_bindir}/cargo-nextest
%{_rpmmacrodir}/macros.cargo-nextest

%changelog
%autochangelog
