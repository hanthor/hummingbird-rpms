From 51f4b60d4f837eee9b3998d81ed2ed53542045cb Mon Sep 17 00:00:00 2001
From: Robert Sturla <rsturla@redhat.com>
Date: Tue, 24 Feb 2026 15:53:32 +0000
Subject: [PATCH 2/3] Stub out GHmac to prevent use of built-in crypto

For FIPS compliance, we need to ensure that GLib's built-in
HMAC implementation (which uses non-validated crypto) is never used.

We stub out the GHmac API entirely so that all HMAC operations fail.
This forces applications to use a FIPS-certified crypto library
directly rather than going through GLib's convenience wrappers.

g_hmac_new() returns NULL, and all other GHmac functions call
g_error() since they should never be reached with a valid GHmac
pointer.

Bug: https://bugzilla.redhat.com/show_bug.cgi?id=1630260
---
 glib/ghmac-fips-stub.c | 132 ++++++++++++++++++++++++++++++++++++++++
 glib/ghmac.c           |  16 +++++
 glib/meson.build       |  10 +++-
 meson.build            |   5 ++
 meson.options          |   5 ++
 5 files changed, 166 insertions(+), 2 deletions(-)
 create mode 100644 glib/ghmac-fips-stub.c

diff --git a/glib/ghmac-fips-stub.c b/glib/ghmac-fips-stub.c
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/glib/ghmac-fips-stub.c
@@ -0,0 +1,132 @@
+/* ghmac-fips-stub.c - stubbed out GHmac for FIPS compliance
+ *
+ * Copyright (C) 2011  Collabora Ltd.
+ * Copyright (C) 2019  Red Hat, Inc.
+ * Copyright (C) 2026  Red Hat, Inc.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this library; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "ghmac.h"
+
+#include "gmem.h"
+#include "gtestutils.h"
+#include "gtypes.h"
+#include "glibintl.h"
+
+#ifndef DISABLE_GHMAC
+#error "build configuration error"
+#endif
+
+/* GHmac is intentionally not usable when this stub implementation is active.
+ * All operations will fail.  The struct is defined here only because other
+ * functions (g_hmac_ref, g_hmac_unref, etc.) reference it, but no valid
+ * GHmac instance will ever be created.
+ */
+struct _GHmac
+{
+  int dummy;
+};
+
+/**
+ * g_hmac_new:
+ *
+ * Stubbed out for FIPS compliance.  Always returns %NULL.
+ *
+ * Applications requiring HMAC functionality should use a
+ * FIPS-certified crypto library (e.g. OpenSSL, GnuTLS) directly.
+ *
+ * Returns: %NULL
+ */
+GHmac *
+g_hmac_new (GChecksumType  digest_type,
+            const guchar  *key,
+            gsize          key_len)
+{
+  g_warning ("GHmac is not supported: GLib has been built with the "
+             "built-in crypto disabled for FIPS compliance. Use a "
+             "FIPS-certified crypto library directly.");
+  return NULL;
+}
+
+GHmac *
+g_hmac_copy (const GHmac *hmac)
+{
+  g_error ("GHmac is not supported: GLib has been built with the "
+           "built-in crypto disabled for FIPS compliance.");
+  return NULL;
+}
+
+GHmac *
+g_hmac_ref (GHmac *hmac)
+{
+  g_error ("GHmac is not supported: GLib has been built with the "
+           "built-in crypto disabled for FIPS compliance.");
+  return NULL;
+}
+
+void
+g_hmac_unref (GHmac *hmac)
+{
+  g_error ("GHmac is not supported: GLib has been built with the "
+           "built-in crypto disabled for FIPS compliance.");
+}
+
+void
+g_hmac_update (GHmac        *hmac,
+               const guchar *data,
+               gssize        length)
+{
+  g_error ("GHmac is not supported: GLib has been built with the "
+           "built-in crypto disabled for FIPS compliance.");
+}
+
+const gchar *
+g_hmac_get_string (GHmac *hmac)
+{
+  g_error ("GHmac is not supported: GLib has been built with the "
+           "built-in crypto disabled for FIPS compliance.");
+  return NULL;
+}
+
+void
+g_hmac_get_digest (GHmac  *hmac,
+                   guint8 *buffer,
+                   gsize  *digest_len)
+{
+  g_error ("GHmac is not supported: GLib has been built with the "
+           "built-in crypto disabled for FIPS compliance.");
+}
diff --git a/glib/ghmac.c b/glib/ghmac.c
index de89d82..0264be5 100644
--- a/glib/ghmac.c
+++ b/glib/ghmac.c
@@ -35,6 +35,10 @@
 #include "gtypes.h"
 #include "glibintl.h"

+#ifdef DISABLE_GHMAC
+#error "build configuration error"
+#endif
+

 /**
  * GHmac:
@@ -89,6 +93,18 @@ struct _GHmac
  * Support for digests of type %G_CHECKSUM_SHA512 has been added in GLib 2.42.
  * Support for %G_CHECKSUM_SHA384 was added in GLib 2.52.
  *
+ * Note that #GHmac creation may fail, in which case this function will
+ * return %NULL. Since there is no error parameter, it is not possible
+ * to indicate why.
+ *
+ * In Fedora, CentOS Stream, and Red Hat Enterprise Linux, GLib is
+ * configured to stub out #GHmac in order to support FIPS compliance.
+ * All calls to g_hmac_new() will return %NULL.  Applications requiring
+ * HMAC functionality should use a FIPS-certified crypto library
+ * (e.g. OpenSSL, GnuTLS) directly.  Other #GHmac functions will abort
+ * with g_error() if called, since no valid #GHmac can be created.
+ *
  * Returns: (nullable) (transfer full): the newly created #GHmac, or %NULL.
  *   Use g_hmac_unref() to free the memory allocated by it.
  *
diff --git a/glib/meson.build b/glib/meson.build
index 239a76f..4749f97 100644
--- a/glib/meson.build
+++ b/glib/meson.build
@@ -284,7 +284,6 @@ glib_sources += files(
   'gfileutils.c',
   'ggettext.c',
   'ghash.c',
-  'ghmac.c',
   'ghmac-utils.c',
   'ghook.c',
   'ghostutils.c',
@@ -406,6 +407,13 @@ else
   glib_dtrace_hdr = []
 endif

+if get_option('disable_ghmac')
+  glib_sources += files('ghmac-fips-stub.c')
+else
+  glib_sources += files('ghmac.c')
+endif
+
 pcre2_static_args = []

 if use_pcre2_static_flag
diff --git a/meson.build b/meson.build
index 883d9a1..7ca9ca6 100644
--- a/meson.build
+++ b/meson.build
@@ -2371,6 +2371,11 @@ if host_system == 'linux'
   endif
 endif

+# Stub out GHmac for FIPS compliance
+if get_option('disable_ghmac')
+  glib_conf.set('DISABLE_GHMAC', 1)
+endif
+
 if host_system == 'windows'
   winsock2 = cc.find_library('ws2_32')
   # Used for g_win32_clear_com() tests...
diff --git a/meson.options b/meson.options
index 5ebbe4d..02663b2 100644
--- a/meson.options
+++ b/meson.options
@@ -37,6 +37,11 @@ option('libmount',
        value : 'auto',
        description : 'build with libmount support')

+option('disable_ghmac',
+       type : 'boolean',
+       value : false,
+       description : 'stub out GHmac for FIPS compliance (disable built-in crypto)')
+
 option('man',
        type : 'boolean',
        value : false,
--
2.53.0


From b6bea9da547bb0948969e8c659ddc7660a7d62ff Mon Sep 17 00:00:00 2001
From: Robert Sturla <rsturla@redhat.com>
Date: Tue, 24 Feb 2026 15:54:34 +0000
Subject: [PATCH 3/3] Disable all HMAC tests when built-in crypto is stubbed
 out

Since GHmac is now stubbed out entirely (g_hmac_new always returns
NULL), all HMAC tests will fail. Disable them when DISABLE_GHMAC is
defined.
---
 glib/tests/hmac.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/glib/tests/hmac.c b/glib/tests/hmac.c
index 3ac3206..6fff518 100644
--- a/glib/tests/hmac.c
+++ b/glib/tests/hmac.c
@@ -1,7 +1,9 @@
+#include "config.h"
 #include <glib.h>
 #include <string.h>
 #include <stdlib.h>

+#ifndef DISABLE_GHMAC
 /* HMAC-MD5 test vectors as per RFC 2202 */

 /* Test 1 */
@@ -81,6 +83,7 @@ guint8 key_md5_test7[] = {
 guint8 result_md5_test7[] = {
     0x6f, 0x63, 0x0f, 0xad, 0x67, 0xcd, 0xa0, 0xee, 0x1f, 0xb1,
     0xf5, 0x62, 0xdb, 0x3a, 0xa5, 0x3e };
+#endif

 /* HMAC-SHA1, HMAC-SHA256, HMAC-SHA384 and HMAC-SHA512 test vectors
  * as per RFCs 2202 and 4868.
@@ -299,6 +302,7 @@ typedef struct {
   gconstpointer result;
 } HmacCase;

+#ifndef DISABLE_GHMAC
 HmacCase hmac_md5_tests[] = {
   { G_CHECKSUM_MD5, key_md5_test1, 16, "Hi There", 8, result_md5_test1 },
   { G_CHECKSUM_MD5, "Jefe", 4, "what do ya want for nothing?", 28,
@@ -336,6 +340,7 @@ HmacCase hmac_sha1_tests[] = {
                " Than One Block-Size Data", 73, result_sha1_test7, },
   { -1, NULL, 0, NULL, 0, NULL },
 };
+#endif

 HmacCase hmac_sha256_tests[] = {
   { G_CHECKSUM_SHA256, key_sha_test1, 20, "Hi There", 8, result_sha256_test1 },
@@ -500,6 +505,7 @@ main (int argc,
   int i;
   g_test_init (&argc, &argv, NULL);

+#ifndef DISABLE_GHMAC
   for (i = 0 ; hmac_sha1_tests[i].key_len > 0 ; i++)
     {
       gchar *name = g_strdup_printf ("/hmac/sha1-%d", i + 1);
@@ -507,6 +513,7 @@ main (int argc,
         (void (*)(const void *)) test_hmac);
       g_free (name);
     }
+#endif

   for (i = 0 ; hmac_sha256_tests[i].key_len > 0 ; i++)
     {
@@ -532,6 +539,7 @@ main (int argc,
       g_free (name);
     }

+#ifndef DISABLE_GHMAC
   for (i = 0 ; hmac_md5_tests[i].key_len > 0 ; i++)
     {
       gchar *name = g_strdup_printf ("/hmac/md5-%d", i + 1);
@@ -539,6 +547,7 @@ main (int argc,
         (void (*)(const void *)) test_hmac);
       g_free (name);
     }
+#endif

   g_test_add_func ("/hmac/ref-unref", test_hmac_ref_unref);
   g_test_add_func ("/hmac/copy", test_hmac_copy);
--
