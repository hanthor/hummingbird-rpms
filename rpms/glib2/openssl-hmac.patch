diff --git a/glib/ghmac-openssl.c b/glib/ghmac-openssl.c
new file mode 100644
index 0000000..da52837
--- /dev/null
+++ b/glib/ghmac-openssl.c
@@ -0,0 +1,312 @@
+/* ghmac-openssl.c - data hashing functions
+ *
+ * Copyright (C) 2011  Collabora Ltd.
+ * Copyright (C) 2019  Red Hat, Inc.
+ * Copyright (C) 2026  Red Hat, Inc.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this library; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <string.h>
+
+#include "ghmac.h"
+
+#include "glib/galloca.h"
+#include "gatomic.h"
+#include "gslice.h"
+#include "gmem.h"
+#include "gstrfuncs.h"
+#include "gchecksumprivate.h"
+#include "gtestutils.h"
+#include "gthread.h"
+#include "gtypes.h"
+#include "glibintl.h"
+
+#ifndef USE_OPENSSL
+#error "build configuration error"
+#endif
+
+/* Opaque types matching OpenSSL 3.x */
+typedef struct ossl_lib_ctx_st OSSL_LIB_CTX;
+typedef struct evp_mac_st EVP_MAC;
+typedef struct evp_mac_ctx_st EVP_MAC_CTX;
+typedef struct ossl_param_st {
+  const char *key;
+  unsigned int data_type;
+  void *data;
+  size_t data_size;
+  size_t return_size;
+} OSSL_PARAM;
+
+/* OSSL_PARAM data types we need */
+#define OSSL_PARAM_UTF8_STRING  4
+#define OSSL_PARAM_END         { NULL, 0, NULL, 0, 0 }
+
+struct _GHmac
+{
+  int ref_count;
+  GChecksumType digest_type;
+  EVP_MAC_CTX *mac_ctx;
+  gchar *digest_str;
+};
+
+/* Why are we dlopening OpenSSL instead of linking to it directly? Because we
+ * want to be able to build GLib as a static library without depending on a
+ * static build of OpenSSL. QEMU depends on static linking with GLib, but
+ * Fedora does not ship a static build of OpenSSL, and this allows us to avoid
+ * changing that.
+ */
+static EVP_MAC *    (*p_EVP_MAC_fetch)      (OSSL_LIB_CTX *libctx, const char *algorithm, const char *properties);
+static EVP_MAC_CTX *(*p_EVP_MAC_CTX_new)    (EVP_MAC *mac);
+static void         (*p_EVP_MAC_CTX_free)   (EVP_MAC_CTX *ctx);
+static EVP_MAC_CTX *(*p_EVP_MAC_CTX_dup)    (const EVP_MAC_CTX *src);
+static int          (*p_EVP_MAC_init)        (EVP_MAC_CTX *ctx, const unsigned char *key, size_t keylen, const OSSL_PARAM params[]);
+static int          (*p_EVP_MAC_update)      (EVP_MAC_CTX *ctx, const unsigned char *data, size_t datalen);
+static int          (*p_EVP_MAC_final)       (EVP_MAC_CTX *ctx, unsigned char *out, size_t *outl, size_t outsize);
+static void         (*p_EVP_MAC_free)        (EVP_MAC *mac);
+static unsigned long (*p_ERR_get_error)      (void);
+static char *       (*p_ERR_error_string)    (unsigned long e, char *buf);
+
+static gsize openssl_initialize_attempted = 0;
+static gboolean openssl_initialize_successful = FALSE;
+static EVP_MAC *hmac_mac = NULL;
+
+static void
+initialize_openssl (void)
+{
+  gpointer libcrypto;
+
+  libcrypto = dlopen ("libcrypto.so.3", RTLD_LAZY | RTLD_GLOBAL);
+  if (!libcrypto)
+    {
+      g_warning ("Cannot use GHmac: failed to load libcrypto.so.3: %s", dlerror ());
+      return;
+    }
+
+#define LOAD_SYM(name) \
+  p_##name = dlsym (libcrypto, #name); \
+  if (!p_##name) \
+    { \
+      g_warning ("Cannot use GHmac: failed to load %s: %s", #name, dlerror ()); \
+      return; \
+    }
+
+  LOAD_SYM (EVP_MAC_fetch)
+  LOAD_SYM (EVP_MAC_CTX_new)
+  LOAD_SYM (EVP_MAC_CTX_free)
+  LOAD_SYM (EVP_MAC_CTX_dup)
+  LOAD_SYM (EVP_MAC_init)
+  LOAD_SYM (EVP_MAC_update)
+  LOAD_SYM (EVP_MAC_final)
+  LOAD_SYM (EVP_MAC_free)
+  LOAD_SYM (ERR_get_error)
+  LOAD_SYM (ERR_error_string)
+
+#undef LOAD_SYM
+
+  /* Fetch the HMAC algorithm once at init time */
+  hmac_mac = p_EVP_MAC_fetch (NULL, "HMAC", NULL);
+  if (!hmac_mac)
+    {
+      g_warning ("Cannot use GHmac: EVP_MAC_fetch(\"HMAC\") failed");
+      return;
+    }
+
+  openssl_initialize_successful = TRUE;
+}
+
+static const char *
+get_openssl_digest_name (GChecksumType digest_type)
+{
+  switch (digest_type)
+    {
+    case G_CHECKSUM_MD5:
+      return "MD5";
+    case G_CHECKSUM_SHA1:
+      return "SHA1";
+    case G_CHECKSUM_SHA256:
+      return "SHA256";
+    case G_CHECKSUM_SHA384:
+      return "SHA384";
+    case G_CHECKSUM_SHA512:
+      return "SHA512";
+    default:
+      return NULL;
+    }
+}
+
+GHmac *
+g_hmac_new (GChecksumType  digest_type,
+            const guchar  *key,
+            gsize          key_len)
+{
+  GHmac *hmac;
+  EVP_MAC_CTX *ctx;
+  const char *digest_name;
+  OSSL_PARAM params[2];
+
+  if (g_once_init_enter (&openssl_initialize_attempted))
+    {
+      initialize_openssl ();
+      g_once_init_leave (&openssl_initialize_attempted, 1);
+    }
+
+  if (!openssl_initialize_successful)
+    return NULL;
+
+  digest_name = get_openssl_digest_name (digest_type);
+  if (!digest_name)
+    {
+      g_return_val_if_reached (NULL);
+    }
+
+  ctx = p_EVP_MAC_CTX_new (hmac_mac);
+  if (!ctx)
+    return NULL;
+
+  /* Set the digest algorithm as a parameter */
+  params[0].key = "digest";
+  params[0].data_type = OSSL_PARAM_UTF8_STRING;
+  params[0].data = (void *) digest_name;
+  params[0].data_size = strlen (digest_name);
+  params[0].return_size = 0;
+  params[1] = (OSSL_PARAM) OSSL_PARAM_END;
+
+  if (!p_EVP_MAC_init (ctx, key, key_len, params))
+    {
+      /* This can fail if e.g. MD5 is requested in FIPS mode */
+      p_EVP_MAC_CTX_free (ctx);
+      return NULL;
+    }
+
+  hmac = g_new0 (GHmac, 1);
+  hmac->ref_count = 1;
+  hmac->digest_type = digest_type;
+  hmac->mac_ctx = ctx;
+
+  return hmac;
+}
+
+GHmac *
+g_hmac_copy (const GHmac *hmac)
+{
+  GHmac *copy;
+
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  copy = g_new0 (GHmac, 1);
+  copy->ref_count = 1;
+  copy->digest_type = hmac->digest_type;
+  copy->mac_ctx = p_EVP_MAC_CTX_dup (hmac->mac_ctx);
+
+  /* g_hmac_copy is not allowed to fail, so we'll have to crash on error. */
+  if (!copy->mac_ctx)
+    {
+      g_free (copy);
+      g_error ("EVP_MAC_CTX_dup failed");
+    }
+
+  return copy;
+}
+
+GHmac *
+g_hmac_ref (GHmac *hmac)
+{
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  g_atomic_int_inc (&hmac->ref_count);
+
+  return hmac;
+}
+
+void
+g_hmac_unref (GHmac *hmac)
+{
+  g_return_if_fail (hmac != NULL);
+
+  if (g_atomic_int_dec_and_test (&hmac->ref_count))
+    {
+      p_EVP_MAC_CTX_free (hmac->mac_ctx);
+      g_free (hmac->digest_str);
+      g_free (hmac);
+    }
+}
+
+
+void
+g_hmac_update (GHmac        *hmac,
+               const guchar *data,
+               gssize        length)
+{
+  g_return_if_fail (hmac != NULL);
+  g_return_if_fail (length == 0 || data != NULL);
+
+  if (length == -1)
+    length = strlen ((const char *)data);
+
+  /* g_hmac_update is not allowed to fail, so we'll have to crash on error. */
+  if (!p_EVP_MAC_update (hmac->mac_ctx, data, length))
+    {
+      unsigned long err = p_ERR_get_error ();
+      g_error ("EVP_MAC_update failed: %s", p_ERR_error_string (err, NULL));
+    }
+}
+
+const gchar *
+g_hmac_get_string (GHmac *hmac)
+{
+  guint8 *buffer;
+  gsize digest_len;
+  size_t out_len;
+
+  g_return_val_if_fail (hmac != NULL, NULL);
+
+  if (hmac->digest_str)
+    return hmac->digest_str;
+
+  digest_len = g_checksum_type_get_length (hmac->digest_type);
+  buffer = g_alloca (digest_len);
+  out_len = digest_len;
+
+  if (!p_EVP_MAC_final (hmac->mac_ctx, buffer, &out_len, digest_len))
+    {
+      unsigned long err = p_ERR_get_error ();
+      g_error ("EVP_MAC_final failed: %s", p_ERR_error_string (err, NULL));
+    }
+
+  hmac->digest_str = gchecksum_digest_to_string (buffer, out_len);
+  return hmac->digest_str;
+}
+
+
+void
+g_hmac_get_digest (GHmac  *hmac,
+                   guint8 *buffer,
+                   gsize  *digest_len)
+{
+  size_t out_len;
+
+  g_return_if_fail (hmac != NULL);
+
+  out_len = *digest_len;
+  if (!p_EVP_MAC_final (hmac->mac_ctx, buffer, &out_len, *digest_len))
+    {
+      unsigned long err = p_ERR_get_error ();
+      g_error ("EVP_MAC_final failed: %s", p_ERR_error_string (err, NULL));
+    }
+  *digest_len = out_len;
+}
