From 9cfc1362aa6f42f2c654ee155b1cffb9063879f6 Mon Sep 17 00:00:00 2001
From: Yusuke Endoh <mame@ruby-lang.org>
Date: Mon, 24 Jun 2024 18:14:05 +0900
Subject: [PATCH] Extend the timeout of test_try_ldflag_invalid_opt and
 test_try_cppflag_invalid_opt

Upstream: https://github.com/ruby/ruby/commit/9cfc1362aa6f42f2c654ee155b1cffb9063879f6

---
 test/mkmf/test_flags.rb | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/test/mkmf/test_flags.rb b/test/mkmf/test_flags.rb
index 6fde46adecbb72..3d908c6bb40b86 100644
--- a/test/mkmf/test_flags.rb
+++ b/test/mkmf/test_flags.rb
@@ -33,7 +33,7 @@ def test_valid_warnflags
   end
 
   def test_try_ldflag_invalid_opt
-    assert_separately([], [], <<-'end;') #do
+    assert_separately([], [], <<-'end;', timeout: 30) #do
       assert(!try_ldflags("nosuch.c"), TestMkmf::MKMFLOG)
       assert(have_devel?, TestMkmf::MKMFLOG)
     end;
@@ -47,7 +47,7 @@ def test_try_cflag_invalid_opt
   end
 
   def test_try_cppflag_invalid_opt
-    assert_separately([], [], <<-'end;') #do
+    assert_separately([], [], <<-'end;', timeout: 30) #do
       assert(!try_cppflags("nosuch.c"), TestMkmf::MKMFLOG)
       assert(have_devel?, TestMkmf::MKMFLOG)
     end;
