+class PatchHandler:
+    def run(self, step: PatchStep, ctx: TransformContext, state: StageState) -> None:
+        if ctx.dry_run:
+            return
+        if not isinstance(step.strip, int) or step.strip < 0:
+            raise GorgetConfigError("Patch strip must be a nonnegative integer")
+        patch = ctx.package_dir / step.file
+        if not patch.is_file():
+            raise GorgetConfigError(f"Patch file does not exist: {patch}")
+        source = ensure_source_dir(ctx, state)
+        # Git applies all hunks atomically and rejects paths outside the source tree.
+        result = run(["git", "apply", f"-p{step.strip}", str(patch.resolve())], cwd=source)
+        if result.returncode != 0:
+            raise GorgetTransientError(f"Patch {step.file} failed: {result.stderr.strip()}")
+        state.source.mark_dirty()
+
+
 class RunHandler:
