+def _update_yarn_versions(
+    module_dir: Path,
+    pins: Sequence[VendorBumpEntry],
+    toolchain: Sequence[ToolchainEntry] = (),
+) -> None:
+    """Derive Yarn selectors from the lockfile and preserve existing major versions."""
+    floors: dict[str, dict[str, str]] = {}
+    for pin in pins:
+        pattern = pin.dependency
+        declared_versions = pin.version
+        assert isinstance(declared_versions, list)
+        if not declared_versions:
+            raise GorgetConfigError("Version arrays must contain nonempty version strings")
+        by_major = {}
+        for version in declared_versions:
+            if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
+                raise GorgetConfigError(f"Invalid Yarn array version: {version!r}")
+            major = version.split(".")[0]
+            if major in by_major:
+                raise GorgetConfigError(f"Duplicate Yarn array major for {pattern}: {major}")
+            by_major[major] = version
+        floors[pattern] = by_major
+    lockfile = module_dir / "yarn.lock"
+    lock = yaml.safe_load(lockfile.read_text()) or {}
+    if "__metadata" not in lock:
+        raise GorgetConfigError("Yarn version arrays require a Berry lockfile")
+    manifest = module_dir / "package.json"
+    data = json.loads(manifest.read_text())
+    resolutions = data.setdefault("resolutions", {})
+    targets: dict[str, dict[str, str]] = {}
+    pending = False
+    for descriptors, entry in lock.items():
+        if descriptors == "__metadata":
+            continue
+        name, protocol, _ = entry.get("resolution", "").partition("@npm:")
+        if not protocol:
+            continue
+        matching = [versions for pattern, versions in floors.items() if fnmatchcase(name, pattern)]
+        if not matching:
+            continue
+        by_major = targets.setdefault(name, {})
+        for versions in matching:
+            for major, branch_floor in versions.items():
+                if major not in by_major or meets_minimum(branch_floor, by_major[major]):
+                    by_major[major] = branch_floor
+        actual = str(entry["version"])
+        floor = by_major.get(actual.split(".")[0])
+        if floor is None or meets_minimum(actual, floor):
+            continue
+        reference = floor
+        # Existing overrides can redirect requests to descriptors absent from the lockfile.
+        for selector, value in list(resolutions.items()):
+            if not isinstance(value, str) or not re.fullmatch(
+                rf"(?:.*/)?{re.escape(name)}(?:@.*)?", selector
+            ):
+                continue
+            version_match = re.fullmatch(r"(?:npm:)?[~^=]*(\d+\.\d+\.\d+)", value)
+            if version_match is not None:
+                inherited = version_match[1]
+                if (inherited.split(".")[0] == actual.split(".")[0]
+                        and not meets_minimum(inherited, floor)):
+                    resolutions[selector] = floor
+        # Retarget upstream patch: references and keep their source patch files.
+        patch_prefix = f"patch:{name}@npm%3A"
+        for selector, value in list(resolutions.items()):
+            if not isinstance(value, str) or not value.startswith(patch_prefix):
+                continue
+            patched_version, separator, patch_path = value[len(patch_prefix):].partition("#")
+            if separator and patched_version.split(".")[0] == actual.split(".")[0]:
+                reference = f"{patch_prefix}{floor}#{patch_path}"
+                resolutions[selector] = reference
+                resolutions[f"{name}@npm:{floor}"] = reference
+        for descriptor in descriptors.split(", "):
+            resolutions[descriptor] = reference
+        pending = True
+    if not pending:
+        return
+    manifest.write_text(json.dumps(data, indent=2) + "\n")
+    command = _yarn_install_cmd(module_dir)
+    result = PackageManager(module_dir, toolchain, runner=run).run(command, lockfile_only=True)
+    if result.returncode != 0:
+        raise GorgetTransientError(f"yarn install failed in {module_dir}: {result.stderr.strip()}")
+    resolved = read_inventory("yarn", module_dir, list(targets), toolchain=toolchain, runner=run)
+    for name, versions in targets.items():
+        for copy in resolved.find(name):
+            floor = versions.get(copy.version.split(".")[0])
+            if floor is not None and not meets_minimum(copy.version, floor):
+                raise GorgetTransientError(
+                    f"Yarn floor failed: {copy.location} is {copy.version}, need {floor}"
+                )
+
+
