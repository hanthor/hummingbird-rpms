+def test_yarn_mixed_version_forms_keep_distinct_scopes(tmp_path, mocker):
+    import yaml
+
+    from gorget.dependencies.update import update_dependencies
+
+    manifest = tmp_path / "package.json"
+    manifest.write_text('{"packageManager":"yarn@4.0.0"}')
+    lock = {"__metadata": {"version": 8}}
+    for name in ("branch", "global"):
+        for major in (1, 2):
+            version = f"{major}.0.0"
+            lock[f"{name}@npm:^{major}"] = {
+                "version": version, "resolution": f"{name}@npm:{version}",
+            }
+    lockfile = tmp_path / "yarn.lock"
+    lockfile.write_text(yaml.safe_dump(lock))
+
+    def install(args, cwd=None, env=None):
+        resolutions = json.loads(manifest.read_text())["resolutions"]
+        for descriptor, entry in lock.items():
+            if descriptor == "__metadata":
+                continue
+            name = descriptor.partition("@npm:")[0]
+            reference = resolutions.get(name, resolutions.get(descriptor))
+            if reference:
+                entry["version"] = reference.removeprefix(">=")
+                entry["resolution"] = f'{name}@npm:{entry["version"]}'
+        lockfile.write_text(yaml.safe_dump(lock))
+        return _ok()
+
+    mocker.patch("gorget.dependencies.update.run", side_effect=install)
+    update_dependencies("yarn", tmp_path, [
+        VendorBumpEntry(dependency="global", version="3.0.1"),
+        VendorBumpEntry(dependency="branch", version=["1.0.1"]),
+    ])
+    assert lock["branch@npm:^1"]["version"] == "1.0.1"
+    assert lock["branch@npm:^2"]["version"] == "2.0.0"
+    assert lock["global@npm:^1"]["version"] == "3.0.1"
+    assert lock["global@npm:^2"]["version"] == "3.0.1"
+
+
