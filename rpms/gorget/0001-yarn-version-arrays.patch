+def test_yarn_version_array_derives_selectors_and_keeps_major_versions(tmp_path, mocker):
+    import yaml
+
+    from gorget.dependencies.update import update_dependencies
+
+    manifest = tmp_path / "package.json"
+    patch = "patch:foo@npm%3A1.0.0#./.yarn/patches/foo.patch"
+    manifest.write_text(json.dumps({
+        "packageManager": "yarn@4.0.0", "resolutions": {"foo@npm:1.0.0": patch},
+    }))
+    lock = {
+        "__metadata": {"version": 8},
+        "foo@npm:1.0.0, foo@npm:^1": {"version": "1.0.0", "resolution": "foo@npm:1.0.0"},
+        "foo@npm:^2": {"version": "2.0.0", "resolution": "foo@npm:2.0.0"},
+        "foo@npm:^3": {"version": "3.0.0", "resolution": "foo@npm:3.0.0"},
+    }
+    (tmp_path / "yarn.lock").write_text(yaml.safe_dump(lock))
+
+    def install(args, cwd=None, env=None):
+        resolutions = json.loads(manifest.read_text())["resolutions"]
+        reference = patch.replace("npm%3A1.0.0#", "npm%3A1.0.1#")
+        assert resolutions == {
+            "foo@npm:1.0.0": reference, "foo@npm:^1": reference,
+            "foo@npm:1.0.1": reference, "foo@npm:^2": "2.0.1",
+        }
+        assert not Path(env["YARN_INSTALL_STATE_PATH"]).is_relative_to(tmp_path)
+        for entry in list(lock.values())[1:]:
+            if entry["version"] != "3.0.0":
+                entry["version"] = entry["version"][:-1] + "1"
+        (tmp_path / "yarn.lock").write_text(yaml.safe_dump(lock))
+        return _ok()
+
+    mock_run = mocker.patch("gorget.dependencies.update.run", side_effect=install)
+    update_dependencies(
+        "yarn", tmp_path, [VendorBumpEntry(dependency="fo*", version=["1.0.1", "2.0.1"])]
+    )
+    assert mock_run.call_count == 1
+    # A repeated run keeps all selectors and performs no install.
+    update_dependencies(
+        "yarn", tmp_path, [VendorBumpEntry(dependency="fo*", version=["1.0.1", "2.0.1"])]
+    )
+    assert mock_run.call_count == 1
+
+
