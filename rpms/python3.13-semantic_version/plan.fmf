execute:
  how: tmt
discover:
  how: shell
  dist-git-source: true
  tests:
  - name: bundled tests
    require:
    - python3.13
    - python3.13-semantic_version
    - python3.13-pytest
    test: |
      cd $(dirname $TMT_SOURCE_DIR/python-semanticversion-*/tests) &&
      rm -rf semantic_version* &&
      python3.13 -m pytest
