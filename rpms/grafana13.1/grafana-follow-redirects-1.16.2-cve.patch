+++ b/package.json
@@ -466,7 +466,7 @@
     "joi@npm:^17.11.0": "17.13.8",
     "joi@npm:^18.2.1": "18.2.9",
     "hono": "4.13.11",
-    "follow-redirects": "1.16.1"
+    "follow-redirects": "1.16.2"
   },
