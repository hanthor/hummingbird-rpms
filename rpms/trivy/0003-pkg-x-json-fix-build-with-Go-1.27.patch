From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hummingbird <hummingbird@redhat.com>
Date: Wed, 9 Sep 2026 11:41:00 +0000
Subject: [PATCH] pkg/x/json: fix build with Go 1.27

Go 1.27 removed the SkipFunc sentinel error from the encoding/json/v2
experiment in favor of errors.ErrUnsupported (golang/go#74324,
https://go-review.googlesource.com/c/go/+/745041). trivy 0.74.0
predates that change and still returns json.SkipFunc, which no longer
exists once GOEXPERIMENT=jsonv2 is built with the Go 1.27.0 stdlib,
breaking the build with:

    pkg/x/json/json.go:109:16: undefined: json.SkipFunc

Backported from the upstream fix that shipped in trivy's own Go 1.27
migration, restricted to the two json.SkipFunc call sites that exist
in v0.74.0 (verified via a full source-tree grep for "json.SkipFunc"
against the v0.74.0 tag; no other occurrences exist). The go.mod
`go 1.27.0` directive bump from that commit is not needed here since
the hermetic build already resolves the correct toolchain:
https://github.com/aquasecurity/trivy/commit/dc3c56eed58ab21c7e08d26757c517bc946a86c5

diff --git a/pkg/x/json/json.go b/pkg/x/json/json.go
index e0d5e7df29..85cf59a23a 100644
--- a/pkg/x/json/json.go
+++ b/pkg/x/json/json.go
@@ -4,6 +4,7 @@ import (
 	"bytes"
 	"encoding/json/jsontext"
 	"encoding/json/v2"
+	"errors"
 	"io"
 
 	"golang.org/x/xerrors"
@@ -106,7 +107,8 @@ func unmarshaler[T any](r *lineReader, visited set.Set[int], hooks ...DecodeHook
 
 		// Check visited set to avoid infinity loops
 		if visited.Contains(start) {
-			return json.SkipFunc
+			// Fall back to the default decoding.
+			return errors.ErrUnsupported
 		}
 		visited.Append(start)
 
diff --git a/pkg/iac/scanners/cloudformation/parser/parameter.go b/pkg/iac/scanners/cloudformation/parser/parameter.go
index 10b1368e6c..1baa2b0302 100644
--- a/pkg/iac/scanners/cloudformation/parser/parameter.go
+++ b/pkg/iac/scanners/cloudformation/parser/parameter.go
@@ -54,7 +54,8 @@ func unmarshalIntFirst(dec *jsontext.Decoder, v *any) error {
 		}
 		return nil
 	}
-	return json.SkipFunc
+	// Fall back to the default decoding.
+	return errors.ErrUnsupported
 }
 
 func (p *Parameter) Type() cftypes.CfType {
-- 
2.51.0

