From: Hummingbird <hummingbird@redhat.com>
Subject: [PATCH] Bump js-yaml 4.1.1 to 4.3.2 for CVE-2026-84375

12.4.14 still pins js-yaml 4.1.1 in one dependency, so the exact 4.1.1
descriptors are resolved to 4.3.2 as well.

diff --git a/package.json b/package.json
index a3d1e743d62a..0c015a2a1c45 100644
--- a/package.json
+++ b/package.json
@@ -474,7 +474,9 @@
     "body-parser@npm:1.20.3": "1.20.9",
     "follow-redirects": "1.16.2",
     "serialize-javascript@npm:^7.0.3": "7.1.4",
-    "joi@npm:^17.11.0": "17.13.9"
+    "joi@npm:^17.11.0": "17.13.9",
+    "js-yaml@npm:4.1.1": "4.3.2",
+    "js-yaml@npm:=4.1.1": "4.3.2"
   },
   "workspaces": {
     "packages": [
diff --git a/yarn.lock b/yarn.lock
index 82cfc8267bbf..c6c087b827fd 100644
--- a/yarn.lock
+++ b/yarn.lock
@@ -23744,14 +23744,14 @@ __metadata:
   languageName: node
   linkType: hard
 
-"js-yaml@npm:4.1.1, js-yaml@npm:=4.1.1":
-  version: 4.1.1
-  resolution: "js-yaml@npm:4.1.1"
+"js-yaml@npm:4.3.2, js-yaml@npm:^4.1.0":
+  version: 4.3.2
+  resolution: "js-yaml@npm:4.3.2"
   dependencies:
     argparse: "npm:^2.0.1"
   bin:
     js-yaml: bin/js-yaml.js
-  checksum: 10c0/561c7d7088c40a9bb53cc75becbfb1df6ae49b34b5e6e5a81744b14ae8667ec564ad2527709d1a6e7d5e5fa6d483aa0f373a50ad98d42fde368ec4a190d4fae7
+  checksum: 10c0/dedd34c2e8fef1d504687f1bc94ed0ee1311a1f78770fa2800352c6d59c635ccf555009d74e9afe529ae62199da2b1ccef30e53dc84dcd8d2d8187c22574bc97
   languageName: node
   linkType: hard
 
@@ -23767,17 +23767,6 @@ __metadata:
   languageName: node
   linkType: hard
 
-"js-yaml@npm:^4.1.0":
-  version: 4.3.2
-  resolution: "js-yaml@npm:4.3.2"
-  dependencies:
-    argparse: "npm:^2.0.1"
-  bin:
-    js-yaml: bin/js-yaml.js
