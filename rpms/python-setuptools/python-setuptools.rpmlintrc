# no %doc in the wheel packages
addFilter(r'python-setuptools-wheel.noarch: (E|W): no-documentation')

# https://github.com/pypa/setuptools/discussions/5326
addFilter(r'[EW]: (zero-length|hidden-file-or-dir) /usr/lib/python3\.\d+/site-packages/setuptools/_vendor/\.lock')

# terms, not spelling errors
addFilter(r"[EW]: spelling-error .+'(distutils|venv)'")
