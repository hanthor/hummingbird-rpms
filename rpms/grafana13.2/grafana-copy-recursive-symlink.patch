+func TestCopyRecursive_SymlinkBeforeTarget(t *testing.T) {
+	src := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(src, ".bin"), 0750))
+	require.NoError(t, os.Mkdir(filepath.Join(src, "uuid"), 0750))
+	require.NoError(t, os.WriteFile(filepath.Join(src, "uuid", "uuid"), []byte("binary"), 0600))
+	require.NoError(t, os.Symlink("../uuid/uuid", filepath.Join(src, ".bin", "uuid")))
+
+	dst := filepath.Join(t.TempDir(), "copy")
+	require.NoError(t, CopyRecursive(src, dst))
+	link, err := os.Readlink(filepath.Join(dst, ".bin", "uuid"))
+	require.NoError(t, err)
+	assert.Equal(t, "../uuid/uuid", link)
+}
