%bcond check 1

# https://github.com/spiffe/spiffe-helper
%global goipath         github.com/spiffe/spiffe-helper
%global forgeurl        https://github.com/spiffe/spiffe-helper
Version:                0.12.1

%gometa -L
%forgemeta


Name:           spiffe-helper
Release:        0.1%{?dist}
Summary:        Fetch and renew SPIFFE credentials for applications

# Generated by go-vendor-tools
License:        Apache-2.0 AND BSD-3-Clause AND ISC AND MIT AND MPL-2.0
URL:            %{gourl}
Source0:        %{gosource}
# Generated by go-vendor-tools
Source1:        %{archivename}-vendor.tar.bz2
Source2:        go-vendor-tools.toml

BuildRequires:  go-vendor-tools
BuildRequires:  golang >= 1.27.1

Requires:       ca-certificates

%description
spiffe-helper retrieves X.509 and JWT SPIFFE credentials from the SPIFFE
Workload API, writes them to disk, and renews them. It can run a command
or signal a process when credentials change.

%prep
%goprep -A
tar -xf %{S:1}

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:2}

%build
%global gomodulesmode GO111MODULE=on
export GO_LDFLAGS="-X github.com/spiffe/spiffe-helper/pkg/version.gittag=v%{version}"
%gobuild -o %{gobuilddir}/bin/spiffe-helper ./cmd/spiffe-helper

%install
%go_vendor_license_install -c %{S:2}
install -m 0755 -vd                     %{buildroot}%{_bindir}
install -m 0755 -vp %{gobuilddir}/bin/* %{buildroot}%{_bindir}/

%check
%go_vendor_license_check -c %{S:2}
%if %{with check}
%gotest ./...
%endif

%files -f %{go_vendor_license_filelist}
%doc README.md helper.conf
%{_bindir}/spiffe-helper


%changelog
%autochangelog
