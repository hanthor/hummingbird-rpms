-PY_HACL_CREATE_MODULE([BLAKE2], [_blake2], [test "$with_builtin_blake2" = yes])
+dnl RHEL: _blake2 needs OpenSSL for FIPS mode detection
+PY_STDLIB_MOD([_blake2], [test "$with_builtin_blake2" = yes], [],
