# https://github.com/grafana/alloy
%global goipath         github.com/grafana/alloy
%global forgeurl        https://github.com/grafana/alloy
Version:                1.18.1

%gometa -L
%forgemeta

Name:           grafana-alloy
Release:        0.1%{?dist}
Summary:        OpenTelemetry Collector distribution with Prometheus pipelines

# Generated by go-vendor-tools
License:        0BSD AND AGPL-3.0-only AND Apache-2.0 AND BSD-2-Clause AND BSD-2-Clause-Views AND BSD-3-Clause AND CC-BY-SA-4.0 AND ISC AND MIT AND MIT-0 AND MPL-2.0 AND PostgreSQL
URL:            %{gourl}
Source0:        %{name}-%{version}.tar.gz
Source1:        %{name}-%{version}-vendor.tar.bz2
Source2:        go-vendor-tools.toml
Source3:        %{name}-collector-%{version}-vendor.tar.bz2
Source4:        %{name}-npm-cache-%{version}.tar.bz2

BuildRequires:  git-core
BuildRequires:  go-vendor-tools
BuildRequires:  nodejs >= 22
BuildRequires:  npm

%description
Grafana Alloy is a vendor-neutral distribution of the OpenTelemetry Collector.
It offers a components-based architecture for collecting, transforming, and
delivering telemetry data including metrics, logs, traces, and profiles.

%prep
%goprep -A
tar -xf %{S:1}
tar -xf %{S:3} -C collector
tar -xf %{S:4} -C internal/web/ui

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:2}

%build
%global gomodulesmode GO111MODULE=on

# Build web UI using vendored npm cache
cd internal/web/ui
npm ci --prefer-offline --cache ./npm-cache
npm run build
cd ../../..
find internal/web/ui -type d -name node_modules -prune -exec rm -rf -- {} +
rm -rf internal/web/ui/npm-cache

# Build alloy binary from collector submodule
export GO_LDFLAGS="-X github.com/grafana/alloy/internal/build.Version=%{version} \
    -X github.com/grafana/alloy/internal/build.Branch=v%{version} \
    -X github.com/grafana/alloy/internal/build.Revision=rpm \
    -X github.com/grafana/alloy/syntax/internal/stdlib.Version=%{version}"
cd collector
%gobuild -o %{gobuilddir}/bin/alloy .
cd ..

%install
%go_vendor_license_install -c %{S:2}
install -m 0755 -vd                     %{buildroot}%{_bindir}
install -m 0755 -vp %{gobuilddir}/bin/* %{buildroot}%{_bindir}/

install -d -m 0755 %{buildroot}%{_sysconfdir}/alloy
install -m 0644 -vp packaging/config.alloy %{buildroot}%{_sysconfdir}/alloy/config.alloy

%global test_ignores %{shrink:
    -d collector
    -d integration-tests
    -d tools
    -d packaging
    -d internal/component/pyroscope/java/integration
    -d internal/component/remote/vault
    -d internal/runtime
}

%check
%go_vendor_license_check -c %{S:2}
rm -rf collector/vendor
rm -rf syntax tools packaging/homebrew integration-tests
%gocheck2 %{test_ignores}

%files -f %{go_vendor_license_filelist}
%doc README.md
%{_bindir}/alloy
%dir %{_sysconfdir}/alloy
%config(noreplace) %{_sysconfdir}/alloy/config.alloy


%changelog
%autochangelog
