%bcond check 1

# https://github.com/prometheus/prometheus
%global goipath         github.com/prometheus/prometheus
%global forgeurl        https://github.com/prometheus/prometheus
Version:                3.5.5

%gometa -L -f

Name:           prometheus3.5
Release:        0.9%{?dist}
Summary:        Monitoring system and time series database
# The offline frontend cache does not include Rollup's native s390x module.
ExcludeArch:    s390x
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT AND MPL-2.0
URL:            %{gourl}
Source0:        %{gosource}
# Generated by go-vendor-tools
Source1:        %{archivename}-vendor.tar.bz2
# npm's architecture-neutral package cache, populated by the source pipeline.
Source2:        prometheus-npm-cache-%{version}.tar.bz2
Source3:        go-vendor-tools.toml
# Generated by the source pipeline's bundled-provides post step; kept in git.
Source4:        bundled-npm-provides.inc
Patch0:         0001-Disable-pprof-debug-endpoints.patch
Patch1:         0002-Backport-x-text-security-update.patch
Patch2:         0003-Make-bigzero-average-test-tolerant.patch
Patch3:         0004-cve-2026-53669-bump-react-router-to-7.18.0.patch
Patch4:         0005-cve-2026-69153-bump-postcss-to-8.5.19.patch
Patch5:         0006-cve-2026-73086-bump-nanoid-to-3.3.12.patch

BuildRequires:  go-vendor-tools
BuildRequires:  golang >= 1.23
BuildRequires:  nodejs24
BuildRequires:  nodejs24-bin
BuildRequires:  nodejs24-npm-bin

%include %{SOURCE4}

%description
Prometheus is a monitoring system and time series database.

%prep
%goprep -p1
tar -xf %{S:1}
tar -xf %{S:2}

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:3}

%build
%global gomodulesmode GO111MODULE=on
# Install frontend dependencies from package-local cache. Lifecycle scripts stay
# disabled; required native tools are shipped as platform-specific npm packages.
export npm_config_cache="$PWD/.npm-cache"
export npm_config_offline=true
export npm_config_audit=false
export npm_config_fund=false
(cd web/ui && npm ci --ignore-scripts)
(cd web/ui/react-app && npm ci --ignore-scripts)
make ui-build
scripts/compress_assets.sh
# Keep build-only frontend dependencies out of license payload discovery.
find web/ui -type d -name node_modules -prune -exec rm -rf -- {} +
rm -rf .npm-cache
export GOWORK=off
export GO_BUILDTAGS="builtinassets"
export GOFLAGS="-mod=vendor -buildvcs=false"
export GO_LDFLAGS="-X github.com/prometheus/common/version.Version=%{version}"
%gobuild -o %{gobuilddir}/bin/prometheus %{goipath}/cmd/prometheus
%gobuild -o %{gobuilddir}/bin/promtool %{goipath}/cmd/promtool

%install
%go_vendor_license_install -c %{S:3}
install -D -p -m 0755 %{gobuilddir}/bin/prometheus %{buildroot}%{_bindir}/prometheus
install -D -p -m 0755 %{gobuilddir}/bin/promtool %{buildroot}%{_bindir}/promtool

%check
%go_vendor_license_check -c %{S:3}
%if %{with check}
export GOWORK=off
# pprof debug routes are deliberately removed by Patch0.
skip_tests=(
    TestDebugHandler # asserts the upstream /debug/pprof endpoint returns HTTP 200
    TestInvalidFileUpdate # file-SD watcher races under Mock's filesystem event timing
    TestUpdateFileWithPartialWrites # same file-SD watcher race under Mock
)
skip_pattern=$(IFS='|'; echo "${skip_tests[*]}")
%gotest -skip "${skip_pattern}" ./...
%endif

%files -f %{go_vendor_license_filelist}
%doc README.md NOTICE
%{_bindir}/prometheus
%{_bindir}/promtool

%changelog
%autochangelog
