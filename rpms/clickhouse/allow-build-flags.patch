Allow RPM builds to opt into distro compiler and linker flags while retaining
upstream's protection against accidental environment pollution by default.

--- a/PreLoad.cmake
+++ b/PreLoad.cmake
@@ -15,12 +15,14 @@ if (NOT DEFINED ENV{XCODE_IDE})
     endif ()
 endif()
 
+option(ALLOW_CUSTOM_BUILD_FLAGS "Allow custom compiler and linker flags" OFF)
+
 # Check if environment is polluted.
-if (NOT "$ENV{CFLAGS}" STREQUAL ""
+if (NOT ALLOW_CUSTOM_BUILD_FLAGS AND (NOT "$ENV{CFLAGS}" STREQUAL ""
     OR NOT "$ENV{CXXFLAGS}" STREQUAL ""
     OR NOT "$ENV{LDFLAGS}" STREQUAL ""
     OR CMAKE_C_FLAGS OR CMAKE_CXX_FLAGS OR CMAKE_EXE_LINKER_FLAGS OR CMAKE_MODULE_LINKER_FLAGS
-    OR CMAKE_C_FLAGS_INIT OR CMAKE_CXX_FLAGS_INIT OR CMAKE_EXE_LINKER_FLAGS_INIT OR CMAKE_MODULE_LINKER_FLAGS_INIT)
+    OR CMAKE_C_FLAGS_INIT OR CMAKE_CXX_FLAGS_INIT OR CMAKE_EXE_LINKER_FLAGS_INIT OR CMAKE_MODULE_LINKER_FLAGS_INIT))
-
+
     # if $ENV
     message("CFLAGS: $ENV{CFLAGS}")
