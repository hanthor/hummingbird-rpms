Use the system libpq while retaining ClickHouse's bundled libpqxx, whose API
is tightly coupled to the ClickHouse sources. Non-SYSTEM include directories
are used so that -I (not -isystem) is generated, bypassing the hermetic
build's --sysroot remapping of system include paths.

--- a/contrib/CMakeLists.txt
+++ b/contrib/CMakeLists.txt
@@ -173,7 +173,13 @@
 
 option(ENABLE_LIBPQXX "Enable PostgreSQL" ${ENABLE_LIBRARIES})
 if (ENABLE_LIBPQXX)
-    add_contrib (postgres-cmake postgres)
+    find_package(PostgreSQL REQUIRED)
+    add_library(_libpq INTERFACE)
+    target_link_libraries(_libpq INTERFACE PostgreSQL::PostgreSQL)
+    # BEFORE INTERFACE (non-SYSTEM) generates -I instead of -isystem,
+    # which is not remapped by the hermetic build's --sysroot.
+    target_include_directories(_libpq BEFORE INTERFACE ${PostgreSQL_INCLUDE_DIRS})
+    add_library(ch_contrib::libpq ALIAS _libpq)
     add_contrib (libpqxx-cmake libpqxx)
 endif()
