Skip Silk fiber tests when io_uring is unavailable.

The Silk test suite registers a global gtest environment that
unconditionally initializes io_uring, aborting the entire test binary
if the syscall is blocked (e.g. by container seccomp policies).  Probe
io_uring availability first and GTEST_SKIP the environment when it
cannot be initialized.  Guard TearDown so it does not call destroy on
a scheduler that was never started.

--- a/src/IO/tests/gtest_silk_fiber_stream_socket.cpp	2026-08-01 22:09:08.783811173 +0100
+++ b/src/IO/tests/gtest_silk_fiber_stream_socket.cpp	2026-08-01 23:15:27.344980611 +0100
@@ -15,6 +15,8 @@
 #include <silk/fibers/future.h>
 #include <silk/util/init.h>
 
+#include <liburing.h>
+
 #include <Poco/Exception.h>
 #include <Poco/Net/Context.h>
 #include <Poco/Net/NetException.h>
@@ -36,19 +38,33 @@
 
 class SilkEnvironment : public ::testing::Environment
 {
+    bool initialized = false;
+
 public:
     void SetUp() override
     {
+        struct io_uring probe_ring;
+        int r = io_uring_queue_init(1, &probe_ring, 0);
+        if (r < 0)
+        {
+            GTEST_SKIP() << "io_uring unavailable (blocked by seccomp or unsupported kernel)";
+            return;
+        }
+        io_uring_queue_exit(&probe_ring);
+
         /// TODO(mstetsyuk): Silk::initializeFiberScheduler and Silk::destroyFiberScheduler are coming in another PR.
         silk::initialize();
         silk::FiberScheduler::Options options;
         /// OpenSSL handshakes run on fiber stacks and need more room than the silk default.
         options.fiberStackSize = 320 * 1024;
         silk::FiberScheduler::initialize(&options);
+        initialized = true;
     }
 
     void TearDown() override
     {
+        if (!initialized)
+            return;
         silk::FiberScheduler::destroy();
         silk::destroy();
     }
