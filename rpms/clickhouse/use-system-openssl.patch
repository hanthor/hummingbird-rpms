Use the operating system's OpenSSL for ClickHouse and its Rust delta-kernel
dependency. Keep bundled OpenSSL as the upstream default.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8bdb240cb..590420355 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -631,6 +631,11 @@ enable_testing() # Enable for tests without binary
 
 set(ENABLE_OPENSSL_DYNAMIC_DEFAULT OFF)
 option(ENABLE_OPENSSL_DYNAMIC "This option removes SSL from ClickHouse and will link to the OpenSSL version supplied by OS." ${ENABLE_OPENSSL_DYNAMIC_DEFAULT})
+option(USE_SYSTEM_OPENSSL "Use OpenSSL supplied by the operating system" OFF)
+if (USE_SYSTEM_OPENSSL)
+    find_package(OpenSSL REQUIRED COMPONENTS Crypto SSL)
+    message(STATUS "Using system OpenSSL ${OPENSSL_VERSION}")
+endif ()
 
 # when installing to /usr - place configs to /etc but for /usr/local place to /usr/local/etc
 if (CMAKE_INSTALL_PREFIX STREQUAL "/usr")
diff --git a/contrib/CMakeLists.txt b/contrib/CMakeLists.txt
index 274a4328e..d015f731a 100644
--- a/contrib/CMakeLists.txt
+++ b/contrib/CMakeLists.txt
@@ -48,7 +48,9 @@ disable_heavy_build_check_if_needed()
 disable_dummy_launchers_if_needed()
 
 # We need to add OpenSSL first so that all our projects use our own version instead of the system one.
-add_contrib (openssl-cmake openssl)  # Needed for delta-lake
+if (NOT USE_SYSTEM_OPENSSL)
+    add_contrib (openssl-cmake openssl)  # Needed for delta-lake
+endif ()
 
 if (USE_MUSL)
     add_contrib (musl-cmake musl)
diff --git a/contrib/delta-kernel-rs-cmake/CMakeLists.txt b/contrib/delta-kernel-rs-cmake/CMakeLists.txt
index 3141a417d..5f82b2c30 100644
--- a/contrib/delta-kernel-rs-cmake/CMakeLists.txt
+++ b/contrib/delta-kernel-rs-cmake/CMakeLists.txt
@@ -37,16 +37,27 @@ clickhouse_config_crate_flags(delta_kernel_ffi)
 # Path for autogenerated files (`delta_kernel_ffi.hpp`)
 set(DELTA_KERNEL_TARGET_PATH ${DELTA_KERNEL_RS_BINARY_DIR}/include)
 
-corrosion_set_env_vars(delta_kernel_ffi
-        "CARGO_HOME=${CMAKE_BINARY_DIR}/contrib/corrosion-cmake/"
-        "CARGO_TARGET_DIR=${DELTA_KERNEL_TARGET_PATH}"
-        "OPENSSL_LIBS=ssl:crypto"
-        "OPENSSL_STATIC=1"
-        "OPENSSL_LIB_DIR=${CMAKE_BINARY_DIR}/contrib/openssl-cmake/"
-        "OPENSSL_INCLUDE_DIR=${ClickHouse_SOURCE_DIR}/contrib/openssl-cmake/common/include/"
-        # The build-script for `openssl-sys` expects all includes to be in one path
-        # but the CMake build for OpenSSL results in headers in two different places
-        "CFLAGS=${RUST_CFLAGS} -I ${ClickHouse_SOURCE_DIR}/contrib/openssl/include/")
+if (USE_SYSTEM_OPENSSL)
+    get_filename_component(OPENSSL_SYSTEM_LIBRARY_DIR "${OPENSSL_CRYPTO_LIBRARY}" DIRECTORY)
+    corrosion_set_env_vars(delta_kernel_ffi
+            "CARGO_HOME=${CMAKE_BINARY_DIR}/contrib/corrosion-cmake/"
+            "CARGO_TARGET_DIR=${DELTA_KERNEL_TARGET_PATH}"
+            "OPENSSL_LIBS=ssl:crypto"
+            "OPENSSL_LIB_DIR=${OPENSSL_SYSTEM_LIBRARY_DIR}"
+            "OPENSSL_INCLUDE_DIR=${OPENSSL_INCLUDE_DIR}"
+            "CFLAGS=${RUST_CFLAGS} -I ${OPENSSL_INCLUDE_DIR}")
+else()
+    corrosion_set_env_vars(delta_kernel_ffi
+            "CARGO_HOME=${CMAKE_BINARY_DIR}/contrib/corrosion-cmake/"
+            "CARGO_TARGET_DIR=${DELTA_KERNEL_TARGET_PATH}"
+            "OPENSSL_LIBS=ssl:crypto"
+            "OPENSSL_STATIC=1"
+            "OPENSSL_LIB_DIR=${CMAKE_BINARY_DIR}/contrib/openssl-cmake/"
+            "OPENSSL_INCLUDE_DIR=${ClickHouse_SOURCE_DIR}/contrib/openssl-cmake/common/include/"
+            # The build-script for `openssl-sys` expects all includes to be in one path
+            # but the CMake build for OpenSSL results in headers in two different places
+            "CFLAGS=${RUST_CFLAGS} -I ${ClickHouse_SOURCE_DIR}/contrib/openssl/include/")
+endif()
 
 # aws-lc-sys's memcmp_check links a small test binary via cc; clang adds
 # -lgcc_s / -lgcc_eh by default but the bundled Linux sysroot ships only
