+	if err != nil {
+		return "", fmt.Errorf("impersonate: unable to marshal claims: %w", err)
+	}
+	signJWTReq := signJWTRequest{
+		Payload:   string(payloadBytes),
+		Delegates: u.delegates,
+	}
