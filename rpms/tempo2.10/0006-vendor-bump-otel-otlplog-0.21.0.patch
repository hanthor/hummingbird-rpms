-func sortMap(m []KeyValue) []KeyValue {
-	sm := make([]KeyValue, len(m))
-	copy(sm, m)
-	slices.SortFunc(sm, func(a, b KeyValue) int {
-		return cmp.Compare(a.Key, b.Key)
-	})
-
-	return sm
-}
