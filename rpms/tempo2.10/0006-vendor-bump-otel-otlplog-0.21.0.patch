-// Kind returns the Kind of v.
-func (v Value) Kind() Kind {
-	switch x := v.any.(type) {
-	case Kind:
-		return x
-	case stringptr:
-		return KindString
-	case bytesptr:
-		return KindBytes
-	case sliceptr:
-		return KindSlice
-	case mapptr:
-		return KindMap
-	default:
-		return KindEmpty
-	}
-}
