-
-// Base removes any anchor information from the schema
-func (id ID) Base() ID {
-	s := id.String()
-	i := strings.LastIndex(s, "#")
-	if i != -1 {
-		s = s[0:i]
-	}
-	s = strings.TrimRight(s, "/")
-	return ID(s)
-}
-
-// String provides string version of ID
