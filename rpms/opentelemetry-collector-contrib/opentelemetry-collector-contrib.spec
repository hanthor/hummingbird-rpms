%bcond check 1

# https://github.com/open-telemetry/opentelemetry-collector-contrib
%global goipath         github.com/open-telemetry/opentelemetry-collector-contrib/cmd/otelcontribcol
%global forgeurl        https://github.com/open-telemetry/opentelemetry-collector-contrib
Version:                0.153.0

%gometa -L
%forgemeta

Name:           opentelemetry-collector-contrib
Release:        1%{?dist}
Summary:        OpenTelemetry Collector with community-contributed components

# Generated by go-vendor-tools
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT AND MIT-0 AND MPL-2.0
URL:            %{gourl}
Source0:        %{gosource}
# Generated by OCB (cmd/builder): go.mod, go.sum, main.go, main_others.go,
# main_windows.go, components.go — see rpms/opentelemetry-collector-contrib/create-vendor-tarball.sh
Source1:        %{archivename}-generated.tar.bz2
# Vendor archive: go_vendor_archive create is passed cmd/otelcontribcol/ directly,
# so the archive has a bare vendor/ prefix (no subdirectory prefix).
# Extract inside pushd cmd/otelcontribcol.
Source2:        %{archivename}-vendor.tar.bz2
Source3:        go-vendor-tools.toml

Source10:       config.yaml

BuildRequires:  go-vendor-tools
BuildRequires:  golang >= 1.24


%description
The OpenTelemetry Collector Contrib distribution includes all
community-contributed receivers, processors, exporters, extensions,
and connectors in addition to the core components.

This package provides the otelcontribcol binary, which includes 100+
components for ingesting telemetry from diverse sources and forwarding
to various backends.


%prep
%goprep -p1
# LICENSE lives at repo root; copy to module dir for go_vendor_license
cp LICENSE cmd/otelcontribcol/LICENSE
# Both the generated sources and vendor archives have bare prefix;
# extract both inside the module directory.
pushd cmd/otelcontribcol
tar -xf %{S:1}
tar -xf %{S:2}
popd
# Fix version string and description embedded by OCB in generated code
sed -i 's/\(Version:[[:space:]]*"\)[0-9.]*-dev/\1%{version}/' cmd/otelcontribcol/main.go
sed -i 's/Local OpenTelemetry Collector Contrib binary, testing only\./OpenTelemetry Collector contrib distribution./' cmd/otelcontribcol/main.go


%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:3}


%build
%global gomodulesmode GO111MODULE=on
pushd cmd/otelcontribcol
%gobuild -o %{gobuilddir}/bin/otelcontribcol .
popd


%install
# go_vendor_license runs from cmd/otelcontribcol/ so it only scans that directory
# (not the entire monorepo source tree). Config paths are relative to cmd/otelcontribcol/.
pushd cmd/otelcontribcol
%go_vendor_license_install -c %{S:3}
popd
# licenses.list is written relative to pushd cwd; move to source root for %files
mv cmd/otelcontribcol/licenses.list .

install -D -p -m 0755 %{gobuilddir}/bin/otelcontribcol %{buildroot}%{_bindir}/otelcontribcol

# default config for container deployments
install -D -p -m 0644 %{S:10} %{buildroot}%{_sysconfdir}/otelcontribcol/config.yaml


%check
pushd cmd/otelcontribcol
%go_vendor_license_check -c %{S:3}
%if %{with check}
%gocheck2
%endif
popd


%files -f %{go_vendor_license_filelist}
%doc README.md
%{_bindir}/otelcontribcol
%config(noreplace) %{_sysconfdir}/otelcontribcol/config.yaml


%changelog
%autochangelog
