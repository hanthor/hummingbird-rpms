ExclusiveArch:  x86_64 aarch64
BuildRequires:  rust >= 1.95
BuildRequires:  cargo
BuildRequires:  cargo-rpm-macros >= 28
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  make
BuildRequires:  cmake
BuildRequires:  clang-devel
BuildRequires:  pkgconfig(openssl)
BuildRequires:  pkgconfig(libsasl2)
BuildRequires:  pkgconfig(rdkafka) >= 2.12.1
BuildRequires:  pkgconfig(libzstd)
BuildRequires:  pkgconfig(zlib)
BuildRequires:  protobuf-compiler
BuildRequires:  perl-interpreter
BuildRequires:  git-core
BuildRequires:  systemd-rpm-macros
BuildRequires:  systemd-devel
BuildRequires:  systemd-standalone-sysusers
%{?sysusers_requires_compat}
%{?systemd_ordering}

%description
Vector collects, transforms, and routes observability data. It supports logs
and metrics from multiple sources and sends them to local or remote services.

%prep
%autosetup -p1
tar xf %{SOURCE1}
# Set the RPM build profile and use Cargo's generated source replacements.
%cargo_prep -N
cat vendor-config.toml >> .cargo/config.toml
# Rust attributes begin with #! but are not executable script shebangs.
find vendor -type f -name '*.rs' -exec chmod a-x {} +

%build
export VECTOR_BUILD_DESC="%{name}-%{version}-%{release}"
# Preserve upstream's 64 KiB page support after cargo_prep replaces its config.
export JEMALLOC_SYS_WITH_LG_PAGE=16
# Upstream enables openssl/vendored; use the system OpenSSL libraries.
export OPENSSL_NO_VENDOR=1
# Link Kafka support against system librdkafka with Kerberos support enabled.
%cargo_build -f gssapi,rdkafka/dynamic-linking -- --frozen --bin vector
%cargo_vendor_manifest
%{cargo_license -f gssapi,rdkafka/dynamic-linking} > LICENSE.dependencies

%install
install -Dpm0755 target/rpm/vector %{buildroot}%{_bindir}/vector
install -Dpm0644 config/vector.yaml %{buildroot}%{_sysconfdir}/vector/vector.yaml
install -Dpm0644 distribution/systemd/vector.service %{buildroot}%{_unitdir}/vector.service
install -Dpm0644 distribution/systemd/vector.default %{buildroot}%{_sysconfdir}/default/vector
install -Dpm0644 %{SOURCE2} %{buildroot}%{_sysusersdir}/vector.conf
install -d -m0750 %{buildroot}%{_sharedstatedir}/vector

%check
# Keep test compilation inexpensive without changing the shipped binary.
%define rustflags_opt_level 1
%define rustflags_codegen_units 16
%define rustflags_debuginfo 0
export JEMALLOC_SYS_WITH_LG_PAGE=16
export OPENSSL_NO_VENDOR=1
%cargo_test -f gssapi,rdkafka/dynamic-linking -- --frozen --package vector --lib --config profile.rpm.lto=false --config profile.rpm.opt-level=1 --config profile.rpm.codegen-units=16 --config profile.rpm.debug=0
target/rpm/vector --version
target/rpm/vector validate --no-environment --skip-healthchecks config/vector.yaml

%pre
%sysusers_create_compat %{SOURCE2}

%post
%systemd_post vector.service

%preun
%systemd_preun vector.service

%postun
%systemd_postun_with_restart vector.service

%files
%license LICENSE NOTICE LICENSE-3rdparty.csv licenses LICENSE.dependencies cargo-vendor.txt
%doc README.md
%{_bindir}/vector
%{_unitdir}/vector.service
%{_sysusersdir}/vector.conf
%dir %{_sysconfdir}/vector
%config(noreplace) %{_sysconfdir}/vector/vector.yaml
%config(noreplace) %{_sysconfdir}/default/vector
%attr(0750,vector,vector) %dir %{_sharedstatedir}/vector

%changelog
%autochangelog
