From 57810562ece3f3bf0915f95db6e756ec5b0c1e22 Mon Sep 17 00:00:00 2001
From: Robert Sturla <rsturla@redhat.com>
Date: Thu, 15 Oct 2026 20:45:52 +0100
Subject: [PATCH] fix(gdb): backport deterministic address maps to 18.1

Upstream-Status: Pending (not submitted)
Origin: Local backport of 201470151c04c11fdc99d30e4f77cdd006a1649d,
based on upstream GDB 835aee81fa93e587eb9ac73a79e911361ec46d6f.
Refreshed for GDB 18.1. The address-map changes are unchanged.

Use the same stable CU priority during parallel collection and map merging. Keep parallel indexing and publish one valid address table.

Preserve empty maps after a DWARF reader error and test index saving after the error.

Assisted-by: Codex:GPT-6 [functions.exec] [exec_command]
---
 gdb/addrmap.c                                 | 52 +++++++++++
 gdb/addrmap.h                                 | 15 ++-
 gdb/dwarf2/cooked-index-worker.h              |  2 +-
 gdb/dwarf2/cooked-index.c                     | 40 +++++---
 gdb/dwarf2/cooked-index.h                     |  9 +-
 gdb/dwarf2/read.h                             |  7 ++
 gdb/testsuite/gdb.dwarf2/dw2-error.exp        |  5 +
 .../gdb.dwarf2/gdb-index-reproducible.exp     | 92 +++++++++++++++++++
 8 files changed, 203 insertions(+), 19 deletions(-)
 create mode 100644 gdb/testsuite/gdb.dwarf2/gdb-index-reproducible.exp

diff --git a/gdb/addrmap.c b/gdb/addrmap.c
--- a/gdb/addrmap.c
+++ b/gdb/addrmap.c
@@ -239,6 +239,8 @@
 	{
 	  /* Already mapped.  */
 	  full_range = false;
+	  if (m_prefer != nullptr && m_prefer (obj, addrmap_node_value (n)))
+	    addrmap_node_set_value (n, obj);
 	}
       else
 	addrmap_node_set_value (n, obj);
@@ -488,6 +490,55 @@
   check_addrmap_find (map, array, 14, 19, nullptr);
 }
 
+/* Check priority replacement, coalescing, moves, and the final address.  */
+
+static void
+test_addrmap_priority ()
+{
+  int low = 1, high = 2;
+  auto prefer = [] (const void *a, const void *b)
+    { return *static_cast<const int *> (a) < *static_cast<const int *> (b); };
+
+  for (bool reverse : {false, true})
+    {
+      addrmap_mutable map (prefer);
+      if (reverse)
+	{
+	  map.set_empty (10, 19, &low);
+	  map.set_empty (5, 24, &high);
+	}
+      else
+	{
+	  map.set_empty (5, 24, &high);
+	  map.set_empty (10, 19, &low);
+	}
+      SELF_CHECK (map.find (4) == nullptr);
+      SELF_CHECK (map.find (5) == &high);
+      SELF_CHECK (map.find (9) == &high);
+      SELF_CHECK (map.find (10) == &low);
+      SELF_CHECK (map.find (19) == &low);
+      SELF_CHECK (map.find (20) == &high);
+      SELF_CHECK (map.find (24) == &high);
+      SELF_CHECK (map.find (25) == nullptr);
+
+      addrmap_mutable moved (std::move (map));
+      addrmap_mutable assigned;
+      assigned = std::move (moved);
+      assigned.set_empty (0, CORE_ADDR_MAX, &high);
+      assigned.set_empty (0, CORE_ADDR_MAX, &low);
+      SELF_CHECK (assigned.find (0) == &low);
+      SELF_CHECK (assigned.find (CORE_ADDR_MAX) == &low);
+      int count = 0;
+      assigned.foreach ([&] (CORE_ADDR start, void *obj)
+	{
+	  SELF_CHECK (start == 0 && obj == &low);
+	  ++count;
+	  return 0;
+	});
+      SELF_CHECK (count == 1);
+    }
+}
+
 } /* namespace selftests */
 #endif /* GDB_SELF_TEST */
 
@@ -495,5 +546,6 @@
 {
 #if GDB_SELF_TEST
   selftests::register_test ("addrmap", selftests::test_addrmap);
+  selftests::register_test ("addrmap-priority", selftests::test_addrmap_priority);
 #endif /* GDB_SELF_TEST */
 }
diff --git a/gdb/addrmap.h b/gdb/addrmap.h
--- a/gdb/addrmap.h
+++ b/gdb/addrmap.h
@@ -123,7 +123,12 @@
 {
 public:
 
-  addrmap_mutable () = default;
+  /* PREFER selects NEW_OBJ over OLD_OBJ in an occupied range.
+     A null predicate keeps the first object, as usual.  */
+  using prefer_ftype = bool (*) (const void *new_obj, const void *old_obj);
+  explicit addrmap_mutable (prefer_ftype prefer = nullptr)
+    : m_prefer (prefer)
+  {}
   ~addrmap_mutable ()
   {
     clear ();
@@ -132,7 +137,7 @@
   DISABLE_COPY_AND_ASSIGN (addrmap_mutable);
 
   addrmap_mutable (addrmap_mutable &&other)
-    : tree (other.tree)
+    : tree (other.tree), m_prefer (other.m_prefer)
   {
     other.tree = nullptr;
   }
@@ -144,6 +149,7 @@
       {
 	clear ();
 	tree = other.tree;
+	m_prefer = other.m_prefer;
 	other.tree = nullptr;
       }
     return *this;
@@ -152,7 +158,8 @@
   /* In the mutable address map MAP, associate the addresses from START
      to END_INCLUSIVE that are currently associated with NULL with OBJ
      instead.  Addresses mapped to an object other than NULL are left
-     unchanged.  Return true if the full range is mapped to OBJ.
+     unchanged unless the constructor's predicate prefers OBJ.
+     Return true if the full range was previously empty.
 
      As the name suggests, END_INCLUSIVE is also mapped to OBJ.  This
      convention is unusual, but it allows callers to accurately specify
@@ -215,6 +222,8 @@
      from deleted nodes; they'll be freed when the obstack is freed.  */
   splay_tree tree = nullptr;
 
+  prefer_ftype m_prefer;
+
   /* Various helper methods.  */
   splay_tree_key allocate_key (CORE_ADDR addr);
   void force_transition (CORE_ADDR addr);
diff --git a/gdb/dwarf2/cooked-index-worker.h b/gdb/dwarf2/cooked-index-worker.h
--- a/gdb/dwarf2/cooked-index-worker.h
+++ b/gdb/dwarf2/cooked-index-worker.h
@@ -207,7 +207,7 @@
   signature_to_name_map m_sig_name_map;
 
   /* A writeable addrmap being constructed by this scanner.  */
-  addrmap_mutable m_addrmap;
+  addrmap_mutable m_addrmap {dwarf2_per_cu::prefer_address_owner};
 
   /* The issued complaints.  Only set after done_reading is
      called.  */
diff --git a/gdb/dwarf2/cooked-index.c b/gdb/dwarf2/cooked-index.c
--- a/gdb/dwarf2/cooked-index.c
+++ b/gdb/dwarf2/cooked-index.c
@@ -88,6 +88,29 @@
   gdb_assert (m_shards.empty ());
   m_shards = m_state->release_shards ();
 
+  /* Merge before publishing the maps.  Use the same CU priority within
+     and between shards, so worker partitioning cannot change ownership.  */
+  addrmap_mutable merged (dwarf2_per_cu::prefer_address_owner);
+  for (const auto &shard : m_shards)
+    {
+      if (shard->m_addrmap == nullptr)
+	continue;
+      CORE_ADDR previous_start = 0;
+      void *previous_obj = nullptr;
+      shard->m_addrmap->foreach ([&] (CORE_ADDR start, const void *obj)
+	{
+	  if (previous_obj != nullptr)
+	    merged.set_empty (previous_start, start - 1, previous_obj);
+	  previous_start = start;
+	  previous_obj = const_cast<void *> (obj);
+	  return 0;
+	});
+      if (previous_obj != nullptr)
+	merged.set_empty (previous_start, CORE_ADDR_MAX, previous_obj);
+    }
+  m_addrmap = new (&m_addrmap_storage) addrmap_fixed (&m_addrmap_storage,
+						   &merged);
+
   m_state->set (cooked_state::MAIN_AVAILABLE);
 
   /* Start the first step of index finalization.  */
@@ -254,13 +277,9 @@
 {
   /* Ensure that the address maps are ready.  */
   wait (cooked_state::MAIN_AVAILABLE, true);
-  for (const auto &shard : m_shards)
-    {
-      dwarf2_per_cu *result = shard->lookup (addr);
-      if (result != nullptr)
-	return result;
-    }
-  return nullptr;
+  if (m_addrmap == nullptr)
+    return nullptr;
+  return static_cast<dwarf2_per_cu *> (m_addrmap->find ((CORE_ADDR) addr));
 }
 
 /* See cooked-index.h.  */
@@ -270,10 +289,9 @@
 {
   /* Ensure that the address maps are ready.  */
   wait (cooked_state::MAIN_AVAILABLE, true);
-  std::vector<const addrmap *> result;
-  for (const auto &shard : m_shards)
-    result.push_back (shard->m_addrmap);
-  return result;
+  if (m_addrmap == nullptr)
+    return {};
+  return {m_addrmap};
 }
 
 /* See cooked-index.h.  */
diff --git a/gdb/dwarf2/cooked-index.h b/gdb/dwarf2/cooked-index.h
--- a/gdb/dwarf2/cooked-index.h
+++ b/gdb/dwarf2/cooked-index.h
@@ -146,10 +146,7 @@
      found.  */
   dwarf2_per_cu *lookup (unrelocated_addr addr) override;
 
-  /* Return a new vector of all the addrmaps used by all the indexes
-     held by this object.
-
-     Elements of the vector may be nullptr.  */
+  /* Return the merged address map, in a vector for index writers.  */
   std::vector<const addrmap *> get_addrmaps ();
 
   /* Return the entry that is believed to represent the program's
@@ -207,6 +204,10 @@
      finalization.  */
   void write_to_cache ();
 
+  /* Canonical address map shared by lookups and index writers.  */
+  auto_obstack m_addrmap_storage;
+  addrmap_fixed *m_addrmap = nullptr;
+
   /* The vector of cooked_index objects.  This is stored because the
      entries are stored on the obstacks in those objects.  */
   std::vector<cooked_index_shard_up> m_shards;
diff --git a/gdb/dwarf2/read.h b/gdb/dwarf2/read.h
--- a/gdb/dwarf2/read.h
+++ b/gdb/dwarf2/read.h
@@ -178,6 +178,13 @@ struct dwarf2_per_cu
      point in trying to read it again next time.  */
   packed<bool, 1> files_read;
 
+  /* Resolve overlapping CU ranges independently of worker order.  */
+  static bool prefer_address_owner (const void *new_obj, const void *old_obj)
+  {
+    return (static_cast<const dwarf2_per_cu *> (new_obj)->index
+	    < static_cast<const dwarf2_per_cu *> (old_obj)->index);
+  }
+
 private:
   /* The unit type of this CU.  */
   std::atomic<packed<dwarf_unit_type, 1>> m_unit_type {(dwarf_unit_type)0};
diff --git a/gdb/testsuite/gdb.dwarf2/dw2-error.exp b/gdb/testsuite/gdb.dwarf2/dw2-error.exp
--- a/gdb/testsuite/gdb.dwarf2/dw2-error.exp
+++ b/gdb/testsuite/gdb.dwarf2/dw2-error.exp
@@ -51,3 +51,8 @@
 
 # Now check that we can still break given the minimal symbol.
 gdb_test "break -q main" "Breakpoint $decimal.*"
+
+# Saving an index after a reader error must also remain safe.
+set index_dir [host_standard_output_file index-after-error]
+remote_exec host "mkdir -p $index_dir"
+gdb_test_no_output "save gdb-index $index_dir" "save index after DWARF error"
