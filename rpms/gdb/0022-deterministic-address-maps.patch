+# Check overlapping ranges across workers and within an imported CU.
+
+load_lib dwarf.exp
+require dwarf2_support
+require !readnow
+require {!is_remote host}
+
+standard_testfile main.c -debug.S
+set asm_file [standard_output_file $srcfile2]
+Dwarf::assemble $asm_file {
+    declare_labels imported
+    for {set i 0} {$i < 128} {incr i} {
+	cu {} {
+	    if {$i == 127} {
+		define_label $imported
+	    }
+	    compile_unit {
+		DW_AT_name "unit$i.c"
+		DW_AT_language @DW_LANG_C
+		if {$i == 127} {
+		    MACRO_AT_range {main}
+		}
+	    } {
+		if {$i == 0} {
+		    imported_unit {DW_AT_import %$imported}
+		}
+		subprogram {
+		    DW_AT_name "function$i"
+		    DW_AT_external 1 flag
+		    MACRO_AT_range {main}
+		}
+	    }
+	}
+    }
+}
+
+if {[build_executable "failed to build" $testfile \
+	 [list $srcfile $asm_file] {nodebug}]} {
+    return
+}
+clean_restart $testfile
+require {string equal [have_index $binfile] ""}
+
+set reference ""
+foreach_with_prefix workers {0 1 2 8 24} {
+    clean_restart
+    gdb_test_no_output "maint set worker-threads $workers"
+    gdb_test_no_output "set index-cache enabled off"
+    gdb_load $binfile
+    set dir [standard_output_file "index-$workers"]
+    file mkdir $dir
+    set index "$dir/[file tail $binfile].gdb-index"
+    file delete -force $index
+    gdb_test_no_output "save gdb-index $dir" "save index"
+    gdb_assert {[file exists $index]} "index exists"
+    if {![file exists $index]} {
+	continue
+    }
+    set fd [open $index rb]
+    set contents [read $fd]
+    close $fd
+    if {$workers == 0} {
+	set reference $contents
+    } else {
+	gdb_assert {$contents eq $reference} "index is reproducible"
+    }
+}
+
+# The address table must also remain valid for the index reader.
+set with_index "$binfile.with-index"
+if {[run_on_host "add index" [gdb_find_objcopy] \
+	 "--add-section .gdb_index=$index --set-section-flags .gdb_index=readonly $binfile $with_index"]} {
+    return
+}
+clean_restart [file tail $with_index]
+gdb_test "maint print objfiles" "gdb_index.*" "generated index is used"
+gdb_test "info address function0" "Symbol .*function0.* is a function at address .*"
