From 5c434b390801f5a29870fce24a1b524736e24d96 Mon Sep 17 00:00:00 2001
From: Marek Blaha <mblaha@redhat.com>
Date: Thu, 5 Nov 2026 17:06:41 +0000
Subject: [PATCH 2/2] rpm: authorize command-line package specifications

Rpm.list(), Rpm.list_fd(), install(), upgrade(), downgrade(), and
reinstall() accepted URL and local .rpm specifications without an
authorization check. Those specifications can reach libdnf5's
command-line package loader during repository loading or Goal
resolution, before the existing transaction-execution check.

Classify the submitted specifications with the public libdnf5 predicate
and check POLKIT_EXECUTE_RPM_TRANSACTION using the actual D-Bus sender
before loading repository data or queueing any Goal request. Direct
package actions default to interactive authorization so clients receive
the Polkit prompt immediately; repository-only operations remain
unchanged.
---
 .../interfaces/org.rpm.dnf.v0.rpm.Rpm.xml     | 20 ++++++++
 .../polkit/org.rpm.dnf.v0.policy              |  2 +-
 dnf5daemon-server/services/rpm/rpm.cpp        | 47 +++++++++++++++++++
 dnf5daemon-server/services/rpm/rpm.hpp        |  2 +
 4 files changed, 70 insertions(+), 1 deletion(-)

diff --git a/dnf5daemon-server/dbus/interfaces/org.rpm.dnf.v0.rpm.Rpm.xml b/dnf5daemon-server/dbus/interfaces/org.rpm.dnf.v0.rpm.Rpm.xml
index 57641b1c3..dfa2c6027 100644
--- a/dnf5daemon-server/dbus/interfaces/org.rpm.dnf.v0.rpm.Rpm.xml
+++ b/dnf5daemon-server/dbus/interfaces/org.rpm.dnf.v0.rpm.Rpm.xml
@@ -60,6 +60,8 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
 
             - patterns: list of strings
                 any package matching to any of patterns is returned
+                Patterns that are URLs or local `.rpm` paths require authorization
+                before the daemon loads them.
             - scope: string (default "all")
                 limit packages to one of "all", "installed", "available", "upgrades", "upgradable"
             - arch: list of strings
@@ -120,6 +122,8 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
         @options: an array of key/value pairs to modify install behavior
 
         Mark packages specified by @pkg_specs for installation.
+        URL or local `.rpm` specifications require authorization before they
+        are queued.
 
         Following @options are supported:
 
@@ -129,6 +133,8 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
                 Whether solver can skip packages with broken dependencies to resolve transaction
             - skip_unavailable: boolean, default false
                 Whether nonexisting packages can be skipped.
+            - interactive: boolean, default true
+                Set to "true", when the operation is done by a user, thus user interaction like password prompts can be done.
 
         Unknown options are ignored.
     -->
@@ -143,11 +149,15 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
         @options: an array of key/value pairs to modify upgrade behavior
 
         Mark packages specified by @pkg_specs for upgrade.
+        URL or local `.rpm` specifications require authorization before they
+        are queued.
 
         Following @options are supported:
 
             - repo_ids: list of strings
                 Identifiers of the repos from which the packages could be upgraded.
+            - interactive: boolean, default true
+                Set to "true", when the operation is done by a user, thus user interaction like password prompts can be done.
 
         Unknown options are ignored.
     -->
@@ -190,9 +200,14 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
         @options: an array of key/value pairs to modify downgrade behavior
 
         Mark packages specified by @pkg_specs for downgrade.
+        URL or local `.rpm` specifications require authorization before they
+        are queued.
 
         Following @options are supported:
 
+            - interactive: boolean, default true
+                Set to "true", when the operation is done by a user, thus user interaction like password prompts can be done.
+
         Unknown options are ignored.
     -->
     <method name="downgrade">
@@ -206,9 +221,14 @@ along with libdnf.  If not, see <https://www.gnu.org/licenses/>.
         @options: an array of key/value pairs to modify reinstall behavior
 
         Mark packages specified by @pkg_specs for reinstall.
+        URL or local `.rpm` specifications require authorization before they
+        are queued.
 
         Following @options are supported:
 
+            - interactive: boolean, default true
+                Set to "true", when the operation is done by a user, thus user interaction like password prompts can be done.
+
         Unknown options are ignored.
     -->
     <method name="reinstall">
diff --git a/dnf5daemon-server/polkit/org.rpm.dnf.v0.policy b/dnf5daemon-server/polkit/org.rpm.dnf.v0.policy
index 87c5fecf5..537aa9623 100644
--- a/dnf5daemon-server/polkit/org.rpm.dnf.v0.policy
+++ b/dnf5daemon-server/polkit/org.rpm.dnf.v0.policy
@@ -28,7 +28,7 @@
 
   <action id="org.rpm.dnf.v0.rpm.execute_transaction">
     <description>Execute untrusted rpm transaction</description>
-    <message>Authentication is required to execute an rpm transaction with local or signature-unverified packages.</message>
+    <message>Authentication is required to execute an rpm transaction with untrusted packages or access package files from local paths or URLs.</message>
     <defaults>
         <allow_any>auth_admin</allow_any>
         <allow_inactive>auth_admin</allow_inactive>
diff --git a/dnf5daemon-server/services/rpm/rpm.cpp b/dnf5daemon-server/services/rpm/rpm.cpp
index 0476cad7e..50a41157f 100644
--- a/dnf5daemon-server/services/rpm/rpm.cpp
+++ b/dnf5daemon-server/services/rpm/rpm.cpp
@@ -24,6 +24,7 @@
 
 #include "libdnf5/comps/environment/query.hpp"
 #include "libdnf5/comps/group/query.hpp"
+#include "libdnf5/utils/patterns.hpp"
 
 #include <libdnf5/rpm/package_query.hpp>
 #include <libdnf5/rpm/package_set.hpp>
@@ -383,6 +384,17 @@ std::vector<std::string> get_filter_patterns(dnfdaemon::KeyValueMap options, con
     return filter_patterns;
 }
 
+bool Rpm::authorize_cmdline_package_specs(
+    const std::vector<std::string> & specs, const std::string & sender, bool interactive) {
+    for (const auto & spec : specs) {
+        if (libdnf5::utils::is_cmdline_package_spec(spec)) {
+            return session.check_authorization(dnfdaemon::POLKIT_EXECUTE_RPM_TRANSACTION, sender, interactive);
+        }
+    }
+
+    return true;
+}
+
 libdnf5::rpm::PackageQuery resolve_nevras(
     libdnf5::rpm::PackageQuery base_query, const std::vector<std::string> & nevras) {
     libdnf5::rpm::PackageQuery result(base_query.get_base(), libdnf5::sack::ExcludeFlags::APPLY_EXCLUDES, true);
@@ -593,6 +605,12 @@ sdbus::MethodReply Rpm::list(sdbus::MethodCall & call) {
     call >> options;
 
     bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", false);
+    const auto patterns =
+        dnfdaemon::key_value_map_get<std::vector<std::string>>(options, "patterns", std::vector<std::string>{});
+    if (!authorize_cmdline_package_specs(patterns, call.getSender(), interactive)) {
+        throw std::runtime_error("Not authorized");
+    }
+
     session.fill_sack(interactive);
 
     auto query = filter_packages(options);
@@ -624,6 +642,12 @@ void Rpm::list_fd(sdbus::MethodCall & call, const std::string & transfer_id) {
 
         int out_fd = dbus_unix_fd.get();
         bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", false);
+        const auto patterns =
+            dnfdaemon::key_value_map_get<std::vector<std::string>>(options, "patterns", std::vector<std::string>{});
+        if (!authorize_cmdline_package_specs(patterns, call.getSender(), interactive)) {
+            throw std::runtime_error("Not authorized");
+        }
+
         session.fill_sack(interactive);
         auto query = filter_packages(options);
         std::vector<std::string> package_attrs = dnfdaemon::key_value_map_get<std::vector<std::string>>(
@@ -699,6 +723,12 @@ sdbus::MethodReply Rpm::downgrade(sdbus::MethodCall & call) {
     // read options from dbus call
     dnfdaemon::KeyValueMap options;
     call >> options;
+
+    bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", true);
+    if (!authorize_cmdline_package_specs(specs, call.getSender(), interactive)) {
+        throw std::runtime_error("Not authorized");
+    }
+
     std::vector<std::string> repo_ids = dnfdaemon::key_value_map_get<std::vector<std::string>>(options, "repo_ids", {});
 
     // fill the goal
@@ -721,6 +751,11 @@ sdbus::MethodReply Rpm::install(sdbus::MethodCall & call) {
     dnfdaemon::KeyValueMap options;
     call >> options;
 
+    bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", true);
+    if (!authorize_cmdline_package_specs(specs, call.getSender(), interactive)) {
+        throw std::runtime_error("Not authorized");
+    }
+
     libdnf5::GoalSetting skip_broken;
     if (options.find("skip_broken") != options.end()) {
         skip_broken = dnfdaemon::key_value_map_get<bool>(options, "skip_broken") ? libdnf5::GoalSetting::SET_TRUE
@@ -760,6 +795,12 @@ sdbus::MethodReply Rpm::upgrade(sdbus::MethodCall & call) {
     // read options from dbus call
     dnfdaemon::KeyValueMap options;
     call >> options;
+
+    bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", true);
+    if (!authorize_cmdline_package_specs(specs, call.getSender(), interactive)) {
+        throw std::runtime_error("Not authorized");
+    }
+
     std::vector<std::string> repo_ids = dnfdaemon::key_value_map_get<std::vector<std::string>>(options, "repo_ids", {});
 
     // fill the goal
@@ -785,6 +826,12 @@ sdbus::MethodReply Rpm::reinstall(sdbus::MethodCall & call) {
     // read options from dbus call
     dnfdaemon::KeyValueMap options;
     call >> options;
+
+    bool interactive = dnfdaemon::key_value_map_get<bool>(options, "interactive", true);
+    if (!authorize_cmdline_package_specs(specs, call.getSender(), interactive)) {
+        throw std::runtime_error("Not authorized");
+    }
+
     std::vector<std::string> repo_ids = dnfdaemon::key_value_map_get<std::vector<std::string>>(options, "repo_ids", {});
 
     // fill the goal
diff --git a/dnf5daemon-server/services/rpm/rpm.hpp b/dnf5daemon-server/services/rpm/rpm.hpp
index 27563af48..6b3ee0fe4 100644
--- a/dnf5daemon-server/services/rpm/rpm.hpp
+++ b/dnf5daemon-server/services/rpm/rpm.hpp
@@ -35,6 +35,8 @@ public:
 
 private:
     libdnf5::rpm::PackageQuery filter_packages(const dnfdaemon::KeyValueMap & options);
+    bool authorize_cmdline_package_specs(
+        const std::vector<std::string> & specs, const std::string & sender, bool interactive);
 
     sdbus::MethodReply list(sdbus::MethodCall & call);
     sdbus::MethodReply install(sdbus::MethodCall & call);
