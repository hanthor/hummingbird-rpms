From 9a9d73e248d2d9176c4a93a049310864555ad61a Mon Sep 17 00:00:00 2001
From: Marek Blaha <mblaha@redhat.com>
Date: Thu, 5 Nov 2026 07:59:41 +0000
Subject: [PATCH 1/2] utils: add command-line package specification classifier

Goal::Impl::add_spec() previously combined the internal URL helper with a
local ".rpm" suffix check to decide whether a package specification refers
to a command-line package. That classification needs to be reused by callers
that must authorize external package inputs before libdnf5 opens or
downloads them.

Move the predicate to libdnf5::utils::is_cmdline_package_spec(), expose it
through the public libdnf5 utility API, and use it from Goal and
RepoSack. The function performs no filesystem or network I/O and
recognizes supported URLs and non-URL paths ending in ".rpm". Add tests
for scheme support, case insensitivity, query strings, and local paths.

This centralizes the existing behavior without changing it.
---
 include/libdnf5/utils/patterns.hpp   |  9 +++++++++
 libdnf5/base/goal.cpp                |  3 +--
 libdnf5/repo/repo_sack.cpp           |  6 +++++-
 libdnf5/utils/patterns.cpp           |  8 ++++++++
 test/libdnf5/utils/test_patterns.cpp | 15 +++++++++++++++
 test/libdnf5/utils/test_patterns.hpp |  2 ++
 6 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/include/libdnf5/utils/patterns.hpp b/include/libdnf5/utils/patterns.hpp
index 72b639f1d..0c5a88e1d 100644
--- a/include/libdnf5/utils/patterns.hpp
+++ b/include/libdnf5/utils/patterns.hpp
@@ -38,6 +38,15 @@ LIBDNF_API bool is_glob_pattern(const char * pattern) noexcept;
 /// @return True if a given pattern is a file path
 LIBDNF_API bool is_file_pattern(const std::string & pattern) noexcept;
 
+/// @brief Check if a given package specification is a command-line package.
+///
+/// A command-line package specification is either a supported URL or a local path
+/// ending in ".rpm".
+///
+/// @param spec Text package specification to be tested
+/// @return True if a given specification is a command-line package
+LIBDNF_API bool is_cmdline_package_spec(const std::string & spec);
+
 }  // namespace libdnf5::utils
 
 #endif  // LIBDNF5_UTILS_PATTERNS_HPP
diff --git a/libdnf5/base/goal.cpp b/libdnf5/base/goal.cpp
index cee1aeaed..c042d17ae 100644
--- a/libdnf5/base/goal.cpp
+++ b/libdnf5/base/goal.cpp
@@ -485,8 +485,7 @@ void Goal::Impl::add_spec(GoalAction action, const std::string & spec, const Goa
         group_specs.push_back(
             std::make_tuple(action, libdnf5::transaction::TransactionItemReason::USER, group_spec, group_settings));
     } else {
-        const std::string_view ext(".rpm");
-        if (libdnf5::utils::url::is_url(spec) || (spec.length() > ext.length() && spec.ends_with(ext))) {
+        if (libdnf5::utils::is_cmdline_package_spec(spec)) {
             // spec is a remote rpm file or a local rpm file
             if (action == GoalAction::REMOVE) {
                 throw RuntimeError(M_("Unsupported argument for REMOVE action: {}"), spec);
diff --git a/libdnf5/repo/repo_sack.cpp b/libdnf5/repo/repo_sack.cpp
index e4ef426a9..6eef2f874 100644
--- a/libdnf5/repo/repo_sack.cpp
+++ b/libdnf5/repo/repo_sack.cpp
@@ -51,6 +51,7 @@
 #include "libdnf5/utils/bgettext/bgettext-mark-domain.h"
 #include "libdnf5/utils/fs/file.hpp"
 #include "libdnf5/utils/fs/temp.hpp"
+#include "libdnf5/utils/patterns.hpp"
 
 extern "C" {
 #include <solv/testcase.h>
@@ -233,9 +234,12 @@ std::map<std::string, libdnf5::rpm::Package> RepoSack::add_cmdline_packages(
     std::vector<std::string> rpm_filepaths;
     const std::string_view ext(".rpm");
     for (const auto & spec : paths) {
+        if (!libdnf5::utils::is_cmdline_package_spec(spec)) {
+            continue;
+        }
         if (libdnf5::utils::url::is_url(spec)) {
             rpm_urls.emplace_back(spec);
-        } else if (spec.length() > ext.length() && spec.ends_with(ext)) {
+        } else {
             rpm_filepaths.emplace_back(spec);
         }
     }
diff --git a/libdnf5/utils/patterns.cpp b/libdnf5/utils/patterns.cpp
index f17e6ab51..5cae9d2fb 100644
--- a/libdnf5/utils/patterns.cpp
+++ b/libdnf5/utils/patterns.cpp
@@ -19,7 +19,10 @@
 
 #include "libdnf5/utils/patterns.hpp"
 
+#include "utils/url.hpp"
+
 #include <cstring>
+#include <string_view>
 
 namespace libdnf5::utils {
 
@@ -31,4 +34,9 @@ bool is_file_pattern(const std::string & pattern) noexcept {
     return pattern[0] == '/' || (pattern[0] == '*' && pattern[1] == '/');
 }
 
+bool is_cmdline_package_spec(const std::string & spec) {
+    constexpr std::string_view rpm_extension(".rpm");
+    return url::is_url(spec) || (spec.length() > rpm_extension.length() && spec.ends_with(rpm_extension));
+}
+
 }  // namespace libdnf5::utils
diff --git a/test/libdnf5/utils/test_patterns.cpp b/test/libdnf5/utils/test_patterns.cpp
index a0abcabac..2fe52fbd5 100644
--- a/test/libdnf5/utils/test_patterns.cpp
+++ b/test/libdnf5/utils/test_patterns.cpp
@@ -42,3 +42,18 @@ void UtilsPatternsTest::test_is_glob_pattern() {
     CPPUNIT_ASSERT(is_glob_pattern("glob[sdf]_pattern"));
     CPPUNIT_ASSERT(is_glob_pattern("glob?_pattern"));
 }
+
+
+void UtilsPatternsTest::test_is_cmdline_package_spec() {
+    CPPUNIT_ASSERT(!is_cmdline_package_spec(""));
+    CPPUNIT_ASSERT(!is_cmdline_package_spec("pkg"));
+    CPPUNIT_ASSERT(!is_cmdline_package_spec(".rpm"));
+    CPPUNIT_ASSERT(!is_cmdline_package_spec("gopher://example.com/pkg"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("gopher://example.com/pkg.rpm"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("/repository/pkg.rpm"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("file:///repository/pkg.rpm"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("FILE:///repository/pkg.rpm"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("http://example.com/pkg?marker.rpm"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("https://example.com/pkg"));
+    CPPUNIT_ASSERT(is_cmdline_package_spec("ftp://example.com/pkg"));
+}
diff --git a/test/libdnf5/utils/test_patterns.hpp b/test/libdnf5/utils/test_patterns.hpp
index 4e7ba2a0a..6160f169f 100644
--- a/test/libdnf5/utils/test_patterns.hpp
+++ b/test/libdnf5/utils/test_patterns.hpp
@@ -27,11 +27,13 @@ class UtilsPatternsTest : public CppUnit::TestCase {
     CPPUNIT_TEST_SUITE(UtilsPatternsTest);
     CPPUNIT_TEST(test_is_file_pattern);
     CPPUNIT_TEST(test_is_glob_pattern);
+    CPPUNIT_TEST(test_is_cmdline_package_spec);
     CPPUNIT_TEST_SUITE_END();
 
 public:
     void test_is_file_pattern();
     void test_is_glob_pattern();
+    void test_is_cmdline_package_spec();
 };
 
 #endif  // LIBDNF5_TEST_UTILS_PATTERNS_HPP
