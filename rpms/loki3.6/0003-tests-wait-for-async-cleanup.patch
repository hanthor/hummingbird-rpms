 }
 
 func Test_markerProcessor_StartDeleteOnSuccess(t *testing.T) {
@@ -113,7 +113,7 @@ func Test_markerProcessor_StartDeleteOnSuccess(t *testing.T) {
 		}
 		sort.Strings(actual)
