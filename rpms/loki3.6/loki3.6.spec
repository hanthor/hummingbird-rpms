%bcond check 1

%global goipath github.com/grafana/loki/v3
Version: 3.6.21

%gometa -L

Name:           loki3.6
Release:        0.1%{?dist}
Summary:        Horizontally scalable log aggregation system
# Checkpoint timing and Arrow timestamp tests fail on the s390x builder.
ExcludeArch:    s390x
# Generated by go-vendor-tools
License:        AGPL-3.0-only AND Apache-2.0 AND BSD-2-Clause AND BSD-2-Clause-Views AND BSD-3-Clause AND BSL-1.0 AND CC0-1.0 AND ISC AND MIT AND MPL-2.0 AND OFL-1.1 AND Unlicense
URL:            https://github.com/grafana/loki
Source0:        https://github.com/grafana/loki/archive/refs/tags/v%{version}.tar.gz#/loki-%{version}.tar.gz
Source1:        go-vendor-tools.toml
# v0.0.1 declares MIT in README but predates the upstream LICENSE file.
Source2:        https://raw.githubusercontent.com/mattn/go-localereader/6bae6c923850ab5e0da9f36f69811ffe17064228/LICENSE#/go-localereader-LICENSE
# Generated by go-vendor-tools
Source3:        loki-%{version}-vendor.tar.bz2
Patch0:         0001-tests-use-explicit-loopback-addresses.patch
# Update the encoding/json error text used by Go 1.27.
Patch1:         0002-tests-update-json-error-for-go1.27.patch
# Keep asynchronous cleanup assertions reliable on slower build architectures.
Patch2:         0003-tests-wait-for-async-cleanup.patch
Patch3:         0004-tests-fix-index-builder-partition-revocation.patch
# Use explicit UTC timestamp fixtures so equality is timezone-independent.
Patch4:         0005-tests-use-UTC-for-Arrow-timestamp-expectations.patch

BuildRequires:  go-vendor-tools
BuildRequires:  golang >= 1.26

Provides:       loki = %{version}-%{release}

%description
Grafana Loki is a horizontally scalable, highly available, multi-tenant log
aggregation system inspired by Prometheus. It indexes metadata about logs and
stores compressed log data in object storage.

%package logcli
Summary:        Command-line client for Grafana Loki
Provides:       logcli = %{version}-%{release}

%description logcli
LogCLI is a command-line client for querying and interacting with Grafana Loki.

%package canary
Summary:        Canary application for Grafana Loki
Provides:       loki-canary = %{version}-%{release}

%description canary
Loki Canary writes synthetic log entries and verifies that Grafana Loki can
ingest and query them.

%prep
%setup -q -n loki-%{version}
# Source0 ships a vendor/ tree; drop it so the regenerated Source3 archive
# cannot leave stale files from older dependency versions (e.g. compress
# renamed fse_decoder_amd64.go -> fse_decoder_asm.go in v1.20.2).
rm -rf vendor
tar -xf %{S:3}
install -D -p -m 0644 %{S:2} vendor/github.com/mattn/go-localereader/LICENSE
%autopatch -p1

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:1}

%build
%global gomodulesmode GO111MODULE=on
export GOFLAGS="-mod=vendor -buildvcs=false"
export GO_LDFLAGS="-X %{goipath}/pkg/util/build.Version=%{version} -X %{goipath}/pkg/util/build.Branch=rpm"
%gobuild -o %{gobuilddir}/bin/loki %{goipath}/cmd/loki
%gobuild -o %{gobuilddir}/bin/logcli %{goipath}/cmd/logcli
%gobuild -o %{gobuilddir}/bin/loki-canary %{goipath}/cmd/loki-canary

%install
%go_vendor_license_install -c %{S:1}
install -D -p -m 0755 %{gobuilddir}/bin/loki %{buildroot}%{_bindir}/loki
install -D -p -m 0755 %{gobuilddir}/bin/logcli %{buildroot}%{_bindir}/logcli
install -D -p -m 0755 %{gobuilddir}/bin/loki-canary %{buildroot}%{_bindir}/loki-canary
install -D -p -m 0644 cmd/loki/loki-local-config.yaml %{buildroot}%{_sysconfdir}/loki/config.yml

%check
%go_vendor_license_check -c %{S:1}
%if %{with check}
# Some tests create fixed-name working files beneath os.TempDir. Keep them in
# the package build tree so retained mock state cannot cause ownership clashes.
export TMPDIR="${PWD}/.test-tmp"
mkdir -p "${TMPDIR}"
# Integration packages require external services or container orchestration.
# Keep exact unit-test exclusions here so failures remain visible and auditable.
skip_packages=(
    '/integration'
)
skip_package_pattern=$(IFS='|'; echo "${skip_packages[*]}")
skip_tests=(
    TestPartitionMonitorRebalancing # flaky in-memory Kafka rebalance simulation
    Test_BuilderLoop/error_rpc      # races an asynchronous RPC error counter
    Test_BuilderLoop/context_cancel # races planner shutdown against context cancellation
    TestChunkFlushingIdle           # timing-sensitive idle flush can miss the final stream
    TestDistributorPushToKafka      # kafka/ingester completion count races under CPU contention
    TestAcquireWithTiming           # asserts a sub-10ms acquire, too tight under CPU contention
)
# These only miss their deadlines on aarch64 builders; keep them running elsewhere.
%ifarch aarch64
skip_tests+=(
    TestBackoffTimer           # 10ms timer tolerance is too tight under CPU contention
    TestQueryWrapperMiddleware # slow-connection deadline race panics once context expires
    TestMemStoreStopBeforeStart # pkg/ruler MemStore fails at startup under CPU contention
)
%endif
skip_pattern=$(IFS='|'; echo "${skip_tests[*]}")
# Match upstream's four-package limit to reduce CPU contention and timing-test failures.
%gotest -p=4 ${skip_pattern:+-skip "${skip_pattern}"} $(go list ./... | grep -Ev "${skip_package_pattern}")
%endif

%files -f %{go_vendor_license_filelist}
%doc CHANGELOG.md README.md
%{_bindir}/loki
%dir %{_sysconfdir}/loki
%config(noreplace) %{_sysconfdir}/loki/config.yml

%files logcli -f %{go_vendor_license_filelist}
%doc CHANGELOG.md README.md
%{_bindir}/logcli

%files canary -f %{go_vendor_license_filelist}
%doc CHANGELOG.md README.md
%{_bindir}/loki-canary

%changelog
%autochangelog
