%bcond check 1

%global goipath github.com/thanos-io/thanos
Version:        0.42.4

%gometa -L

Name:           thanos
Release:        1%{?dist}
Summary:        Highly available Prometheus setup with long term storage capabilities
# Generated by go-vendor-tools
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSL-1.0 AND ISC AND LGPL-3.0-only AND MIT AND MPL-2.0 AND Unlicense
URL:            https://github.com/thanos-io/thanos
Source0:        %{gosource}
# Generated by go-vendor-tools
Source1:        %{archivename}-vendor.tar.bz2
Source2:        go-vendor-tools.toml

Patch0:         0001-fix-unsafe-label-conversions-for-stringlabels.patch

BuildRequires:  go-vendor-tools
BuildRequires:  golang >= 1.26

%description
Thanos is a set of components that can be composed into a highly available
metric system with unlimited storage capacity, which can be added seamlessly on
top of existing Prometheus deployments. Thanos leverages the Prometheus storage
format to cost-efficiently store historical metric data in object storage while
retaining fast query latencies. It provides a global query view across all
Prometheus installations and can merge data from Prometheus HA pairs on the fly.

%prep
%goprep -p1
tar -xf %{S:1}

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:2}

%build
%global gomodulesmode GO111MODULE=on
%global our_goldflags %{shrink:
    -X github.com/prometheus/common/version.Version=%{version}
    -X github.com/prometheus/common/version.Branch=rpm
    -X github.com/prometheus/common/version.BuildUser=hummingbird
}
export GO_LDFLAGS=%{shescape:%our_goldflags}
%gobuild -o thanos %{goipath}/cmd/thanos

%install
%go_vendor_license_install -c %{S:2}
install -D -p -m 0755 thanos %{buildroot}%{_bindir}/thanos

%check
%go_vendor_license_check -c %{S:2}
%if %{with check}
# e2e tests require Docker; objstore tests require cloud credentials
%global gocheck2_skips %{shrink:
    -t test/e2e
    -d pkg/store
    -d pkg/api/query
    -d pkg/compact
    -d pkg/promclient
    -d pkg/query
    -d pkg/queryfrontend
    -d pkg/receive
    -d pkg/rules
    -d pkg/shipper
    -s TestIgnoreDeletionMarkFilter_Filter
    -s TestMetaFetcher_Fetch
    -s TestDedupExemplarsResponse
    -s TestExemplarsAPI_Fanout
    -s TestMetadataAPI_Fanout
    -s TestTargetsAPI_Fanout
    -s TestRedisClient_Rueidis
    -s TestGroupKey
    -s TestPrometheus_Metadata_e2e
    -s TestPrometheus_Targets_e2e
    -s TestRulesComparator
}
%gocheck2 %{gocheck2_skips}
%endif

%files -f %{go_vendor_license_filelist}
%doc README.md CHANGELOG.md
%{_bindir}/thanos

%changelog
%autochangelog
