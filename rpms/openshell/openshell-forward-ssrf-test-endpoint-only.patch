@@ -12129,18 +12129,21 @@ network_policies:
     ) -> (Vec<u8>, Vec<String>) {
         const POLICY_REGO: &str = include_str!("../data/sandbox-policy.rego");
 
+        // This helper exercises endpoint validation and response handling. It
