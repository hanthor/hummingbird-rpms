From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Sturla <rsturla@redhat.com>
Date: Tue, 22 Sep 2026 00:00:00 +0000
Subject: [PATCH] network: keep authorization mode consistent with loaded policy

The binary identity mode is used while policy data is preprocessed, but the
forward authorization path reads the environment again for every request.
That allows the policy and the runtime authorization path to use different
modes if the environment changes after the engine is created.

Keep the mode on the engine and use it for runtime authorization. This also
lets the forward-handler regression test explicitly use endpoint-only mode:
the test covers SSRF response handling and denial-stage reporting, not process
identity discovery.

diff --git a/crates/openshell-supervisor-network/src/opa.rs b/crates/openshell-supervisor-network/src/opa.rs
index 63aa2c2..fcfea76 100644
--- a/crates/openshell-supervisor-network/src/opa.rs
+++ b/crates/openshell-supervisor-network/src/opa.rs
@@ -152,6 +152,10 @@ pub struct OpaEngine {
     engine: Mutex<regorus::Engine>,
     generation: Arc<AtomicU64>,
     middleware_runner: RwLock<ChainRunner>,
+    // This must match the mode used to preprocess the policy data. Keeping it
+    // on the engine avoids rereading process-global configuration for every
+    // request.
+    require_binary_identity: bool,
     websocket_assembly_budget: crate::l7::websocket::WebSocketAssemblyBudget,
     generation_tx: watch::Sender<u64>,
     fail_closed_reason: RwLock<Option<String>>,
@@ -278,19 +279,24 @@ impl OpaEngine {
         self.websocket_assembly_budget.clone()
     }

-    fn with_engine(engine: regorus::Engine) -> Self {
+    fn with_engine(engine: regorus::Engine, require_binary_identity: bool) -> Self {
         let generation = Arc::new(AtomicU64::new(0));
         let (generation_tx, _) = watch::channel(0);
         Self {
             engine: Mutex::new(engine),
             generation,
             middleware_runner: RwLock::new(ChainRunner::default()),
+            require_binary_identity,
             websocket_assembly_budget: crate::l7::websocket::WebSocketAssemblyBudget::default(),
             generation_tx,
             fail_closed_reason: RwLock::new(None),
         }
     }

+    pub(crate) fn requires_binary_identity(&self) -> bool {
+        self.require_binary_identity
+    }
+
     fn advance_generation(&self) -> u64 {
         let generation = self.generation.fetch_add(1, Ordering::AcqRel) + 1;
         self.generation_tx.send_replace(generation);
@@ -328,7 +334,7 @@ impl OpaEngine {
         engine
             .add_data_json(&data_json)
             .map_err(|e| miette::miette!("{e}"))?;
-        Ok(Self::with_engine(engine))
+        Ok(Self::with_engine(engine, require_binary_identity))
     }

     /// Load policy rules and data from strings (data is YAML).
@@ -379,7 +385,7 @@ impl OpaEngine {
         engine
             .add_data_json(&data_json)
             .map_err(|e| miette::miette!("{e}"))?;
-        Ok(Self::with_engine(engine))
+        Ok(Self::with_engine(engine, require_binary_identity))
     }

     /// Create OPA engine from a typed proto policy.
@@ -466,7 +472,7 @@ impl OpaEngine {
         engine
             .add_data_json(&data_json)
             .map_err(|e| miette::miette!("{e}"))?;
-        Ok(Self::with_engine(engine))
+        Ok(Self::with_engine(engine, require_binary_identity))
     }

     /// Evaluate a network access request against the loaded policy.
@@ -3572,7 +3578,7 @@ network_policies:
             .expect("policy should load");
         rego.add_data_json(&data_json.to_string())
             .expect("data should load");
-        let engine = OpaEngine::with_engine(rego);
+        let engine = OpaEngine::with_engine(rego, network_binary_identity_required());
         let input = l7_websocket_graphql_input(
             "realtime.graphql.com",
             serde_json::json!([{
diff --git a/crates/openshell-supervisor-network/src/proxy.rs b/crates/openshell-supervisor-network/src/proxy.rs
