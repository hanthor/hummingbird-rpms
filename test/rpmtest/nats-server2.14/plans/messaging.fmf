summary: Check NATS 2.14 messaging
provision:
  how: local
discover:
  how: fmf
  test: ^/nats\-server2\.14/tests/messaging$
prepare:
  how: rpmtest
  packages:
  - nats-server2.14
  repositories:
  - https://packages.redhat.com/api/pulp-content/public-hummingbird/$basearch/
execute:
  how: tmt
finish:
  how: rpmtest
