summary: Test curl transfers in a minimal RPM root
provision:
  how: local
discover:
  how: fmf
  test: ^/curl/tests/transfers$
prepare:
  how: rpmtest
  packages:
  - curl
  repositories:
  - https://packages.redhat.com/api/pulp-content/public-hummingbird/$basearch/
execute:
  how: tmt
finish:
  how: rpmtest
