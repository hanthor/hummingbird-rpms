---
apiVersion: appstudio.redhat.com/v1beta2
kind: IntegrationTestScenario
metadata:
  name: {{ application }}-testing-farm
  labels:
    test.appstudio.openshift.io/optional: "false"
  annotations:
    test.appstudio.openshift.io/pipeline_timeout: 10h
    test.appstudio.openshift.io/tasks_timeout: 9h
    test.appstudio.openshift.io/finally_timeout: 1h
    test.appstudio.openshift.io/snapshot-param-as-name: "true"
spec:
  application: {{ application }}
  contexts:
{%- for ctx in triggers %}
    - {name: {{ ctx }}}
{%- endfor %}
  params:
    - {name: COMPOSE, value: RHEL-9-Nightly}
    - {name: PIPELINE_MODE, value: rpm}
{%- if vars.GIT_URL is defined %}
    # Group snapshots do not include the target repository annotation. Use the
    # allowlisted target repository instead of a contributor's fork.
    - {name: GIT_URL, value: "{{ vars.GIT_URL }}"}
{%- endif %}
    - {name: ARCH, value: "x86_64,aarch64"}
    - {name: PASS_SNAPSHOT_TO_TF, value: "false"}
    # renovate: datasource=docker depName=quay.io/testing-farm/tmt-via-testing-farm
    - {name: IMAGE_TAG, value: v3.22}
  resolverRef:
    resolver: bundles
    params:
      - {name: bundle, value: quay.io/testing-farm/tmt-via-testing-farm:$(params.IMAGE_TAG)}
      - {name: name, value: tmt-via-testing-farm}
      - {name: kind, value: pipeline}
      - {name: url, value: quay.io/testing-farm/tmt-via-testing-farm:$(params.IMAGE_TAG)}
